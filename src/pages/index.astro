---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Concept from "../components/Concept.astro";
import Products from "../components/Products.astro";
import Security from "../components/Security.astro";
import AppFeature from "../components/AppFeature.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <a
    href="#inicio"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-ink"
  >
    Saltar al contenido
  </a>

  <Navbar />

  <main>
    <Hero />
    <Concept />
    <Products />
    <Security />
    <AppFeature />
  </main>

  <Footer />
</Layout>
