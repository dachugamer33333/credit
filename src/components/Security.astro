---
const features = [
  {
    titulo: "Tarjeta sin números impresos",
    descripcion: "Tus datos nunca viajan a la vista. El número vive cifrado y solo se revela en la app.",
    paths: ["M3 5h18v14H3z", "M3 9h18", "M4.5 19.5 19.5 4.5"],
  },
  {
    titulo: "CVV dinámico",
    descripcion: "Un código de seguridad nuevo en cada compra, imposible de reutilizar.",
    paths: [
      "M19 12a7 7 0 0 1-12 5",
      "M7 17v-3h3",
      "M7 14h3",
      "M7 15h1M10.5 15h1M14 15h1",
    ],
  },
  {
    titulo: "Chip EMV",
    descripcion: "Tecnología de chip que firma cada operación y bloquea la clonación.",
    paths: ["M5 6h14v12H5z", "M5 10h14M5 14h14M10 6v12M14 6v12"],
  },
  {
    titulo: "Contactless seguro",
    descripcion: "Paga acercando la tarjeta con tokens cifrados, sin exponer tu identidad.",
    paths: ["M8 9a4 4 0 0 1 0 6", "M11.5 7a7 7 0 0 1 0 10", "M15 5a10 10 0 0 1 0 14"],
  },
  {
    titulo: "Biometría",
    descripcion: "Acceso con huella o rostro. Solo tú autorizas cada movimiento.",
    paths: [
      "M7 10a5 5 0 0 1 10 0",
      "M4.5 12.5a7.5 7.5 0 0 1 15 0",
      "M12 11v6",
      "M9 13.5v3a3 3 0 0 0 6 0v-1",
    ],
  },
  {
    titulo: "Congelamiento instantáneo",
    descripcion: "Pausa y reactiva tu tarjeta en un toque, cuando quieras y desde donde estés.",
    paths: [
      "M12 2v20",
      "M3.3 7l17.4 10",
      "M20.7 7 3.3 17",
      "M12 5 10 3M12 5l2-2M12 19l-2 2M12 19l2 2",
    ],
  },
];
---

<section id="blindaje" class="border-t border-white/10 bg-surface/40">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.32em] text-accent">
        Blindaje EN
      </p>
      <h2 class="text-[clamp(1.875rem,4.5vw,3rem)] font-bold leading-tight text-ink">
        Seguridad que no se ve, pero siempre está
      </h2>
      <p class="mt-4 text-base text-muted">
        Cada capa protege tu proyecto y tus datos. Diseño de defensa en profundidad, de la tarjeta
        al servidor.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <li class="group rounded-2xl border border-white/10 bg-bg/60 p-6 transition duration-300 hover:border-accent/40 hover:bg-bg">
            <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-surface text-accent transition duration-300 group-hover:border-accent/40">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {f.paths.map((d) => (
                  <path d={d}></path>
                ))}
              </svg>
            </span>
            <h3 class="font-display text-lg font-bold text-ink">{f.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{f.descripcion}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
