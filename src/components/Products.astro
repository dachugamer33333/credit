---
import { APP_PATH } from "../config";

const productos = [
  {
    nombre: "Tarjeta Semilla",
    rango: "$5,000 – $20,000",
    moneda: "MXN",
    descripcion: "Para dar el primer paso: materiales, equipo básico y el arranque de tu proyecto.",
    destacado: false,
    beneficios: [
      "Aprobación en línea en minutos",
      "Sin comisión por apertura",
      "Plazos de 6 a 12 meses",
    ],
    cat: "CAT promedio 58.4% sin IVA · Tasa fija 22% anual",
  },
  {
    nombre: "Tarjeta Escena",
    rango: "$20,000 – $70,000",
    moneda: "MXN",
    descripcion: "Para producciones completas: rodajes, eventos, exposiciones y puesta en escena.",
    destacado: true,
    beneficios: [
      "Línea ampliable según avance",
      "Plazos de 12 a 36 meses",
      "Meses de gracia al inicio",
    ],
    cat: "CAT promedio 47.9% sin IVA · Tasa fija 17% anual",
  },
];
---

<section id="productos" class="border-t border-border">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.32em] text-accent">
        Productos
      </p>
      <h2 class="text-[clamp(1.875rem,4.5vw,3rem)] font-bold leading-tight text-ink">
        Dos formas de respaldar tu creación
      </h2>
      <p class="mt-4 text-base text-muted">
        Límites y condiciones ficticias de un proyecto conceptual. Elige el punto de partida que
        mejor se ajusta a tu idea.
      </p>
    </div>

    <div data-products-grid class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        productos.map((p) => (
          <div data-product-card class="flex flex-col">
            <article
              class:list={[
                "relative flex h-full flex-col overflow-hidden rounded-2xl border bg-surface p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition duration-300 sm:p-8",
                p.destacado
                  ? "border-accent/50 shadow-[0_20px_50px_-24px_rgba(29,78,216,0.55)]"
                  : "border-border hover:border-slate-300",
              ]}
            >
              {p.destacado && (
                <span class="absolute right-6 top-6 rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                  Más solicitada
                </span>
              )}

              <h3 class="font-display text-xl font-bold text-ink">{p.nombre}</h3>

              <p class="mt-5 flex items-baseline gap-2">
                <span class="font-display text-3xl font-bold text-ink sm:text-4xl">{p.rango}</span>
                <span class="text-sm font-medium text-muted">{p.moneda}</span>
              </p>

              <p class="mt-4 text-sm leading-relaxed text-muted">{p.descripcion}</p>

              <ul class="mt-6 flex flex-col gap-3 border-t border-border pt-6">
                {p.beneficios.map((b) => (
                  <li class="flex items-start gap-3 text-sm text-muted">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>

              <a
                href={APP_PATH}
                class:list={[
                  "mt-8 inline-flex min-h-11 items-center justify-center rounded-full px-6 text-sm font-semibold transition duration-300",
                  p.destacado
                    ? "bg-accent text-white hover:bg-accent-hover"
                    : "border border-border text-ink hover:border-slate-300 hover:bg-slate-100",
                ]}
              >
                Solicitar {p.nombre.replace("Tarjeta ", "")}
              </a>
            </article>

            <p class="mt-3 px-1 text-xs leading-relaxed text-muted">{p.cat}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.registerPlugin(ScrollTrigger);

    const ctx = gsap.context(() => {
      gsap.from("[data-product-card]", {
        y: 44,
        autoAlpha: 0,
        duration: 0.8,
        ease: "power3.out",
        stagger: 0.16,
        scrollTrigger: {
          trigger: "[data-products-grid]",
          start: "top 80%",
          once: true,
        },
      });
    }, "[data-products-grid]");

    return () => ctx.revert();
  });
</script>
