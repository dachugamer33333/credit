---
// Sin lógica de servidor: la tarjeta se maqueta en CSS/SVG (sin stock).
---

<section id="inicio" class="relative overflow-hidden">
  <!-- Marca de agua kanji 縁 (SVG, opacidad 4%) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg
      class="absolute -right-[18%] top-[-14%] h-[130%] w-auto opacity-[0.04] sm:-right-[8%]"
      viewBox="0 0 400 400"
      fill="none"
      focusable="false"
    >
      <text
        x="200"
        y="210"
        text-anchor="middle"
        dominant-baseline="middle"
        font-family="'Noto Serif JP', serif"
        font-size="360"
        fill="#ffffff">縁</text
      >
    </svg>
    <div
      class="absolute left-1/2 top-0 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"
    >
    </div>
  </div>

  <div
    class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-2 lg:gap-16 lg:px-8"
  >
    <!-- Columna de texto -->
    <div class="max-w-xl">
      <p
        data-hero-anim
        class="mb-5 text-xs font-semibold uppercase tracking-[0.32em] text-accent"
      >
        Financiamiento digital y transparente
      </p>

      <h1
        data-hero-anim
        class="text-[clamp(2.25rem,6vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.02em] text-ink"
      >
        Créditos que impulsan tu futuro y financian tus ideas.
      </h1>

      <p data-hero-anim class="mt-6 max-w-lg text-base leading-relaxed text-muted sm:text-lg">
        La primera tarjeta creada para respaldar proyectos artísticos, creativos y personales sin
        barreras burocráticas.
      </p>

      <div data-hero-anim class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#productos"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-accent px-7 text-sm font-semibold text-ink transition duration-300 hover:bg-accent-hover"
        >
          Solicitar Tarjeta
        </a>
        <a
          href="#concepto"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-white/15 px-7 text-sm font-semibold text-ink transition duration-300 hover:border-white/30 hover:bg-white/5"
        >
          Conocer Requisitos
        </a>
      </div>
    </div>

    <!-- Columna de la tarjeta -->
    <div data-hero-anim class="flex justify-center lg:justify-end">
      <div
        data-tilt-stage
        class="w-full max-w-[26rem] [perspective:1200px]"
      >
        <div
          data-card
          class="relative aspect-[1.586/1] w-full overflow-hidden rounded-[1.25rem] border border-white/10 bg-[linear-gradient(135deg,#17191f_0%,#0b0d12_55%,#05060a_100%)] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)] ring-1 ring-white/5 [transform-style:preserve-3d] [will-change:transform]"
        >
          <!-- Pincelada azul -->
          <span
            class="pointer-events-none absolute -bottom-16 -left-10 h-[70%] w-[70%] -rotate-12 rounded-full bg-[radial-gradient(closest-side,rgba(37,99,235,0.6),transparent)] blur-2xl"
            aria-hidden="true"></span>
          <span
            class="pointer-events-none absolute inset-0 grain opacity-40"
            aria-hidden="true"></span>

          <!-- Kanji sutil en la tarjeta -->
          <span
            class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 font-kanji text-[5.5rem] leading-none text-white/[0.06]"
            aria-hidden="true">縁</span
          >

          <div class="relative flex h-full flex-col justify-between p-5 sm:p-6">
            <div class="flex items-start justify-between">
              <!-- Chip EMV plateado -->
              <span
                class="inline-flex h-9 w-12 overflow-hidden rounded-md bg-[linear-gradient(135deg,#f1f5f9,#94a3b8_55%,#cbd5e1)] ring-1 ring-black/20"
                aria-hidden="true"
              >
                <svg viewBox="0 0 48 36" class="h-full w-full" fill="none">
                  <path
                    d="M0 12h14M0 24h14M34 12h14M34 24h14M14 0v36M34 0v36M14 12h20M14 24h20"
                    stroke="#334155"
                    stroke-width="1"
                    opacity="0.6"></path>
                </svg>
              </span>

              <!-- Contactless -->
              <svg
                class="h-6 w-6 text-white/60"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M7 8.5a5 5 0 0 1 0 7"></path>
                <path d="M10.5 6.5a8 8 0 0 1 0 11"></path>
                <path d="M14 4.5a11 11 0 0 1 0 15"></path>
              </svg>
            </div>

            <div>
              <p class="font-mono text-sm tracking-[0.35em] text-white/85 sm:text-base">
                •••• •••• •••• 縁
              </p>
              <div class="mt-3 flex items-end justify-between">
                <span class="text-xs uppercase tracking-[0.3em] text-white/65"
                  >EN CREDIT</span
                >
                <span class="text-xs text-white/65">12/29</span>
              </div>
              <span class="tri-line mt-3 block h-[3px] w-24 rounded-full" aria-hidden="true"
              ></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  const mm = gsap.matchMedia();

  // 1) Entrada con stagger (se omite si el usuario prefiere menos movimiento)
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.from("[data-hero-anim]", {
      y: 26,
      autoAlpha: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.12,
    });
  });

  // 2) Tilt 3D con el cursor — solo punteros finos con hover
  mm.add(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
    () => {
      const stage = document.querySelector<HTMLElement>("[data-tilt-stage]");
      const card = document.querySelector<HTMLElement>("[data-card]");
      if (!stage || !card) return;

      const rx = gsap.quickTo(card, "rotationX", { duration: 0.5, ease: "power3" });
      const ry = gsap.quickTo(card, "rotationY", { duration: 0.5, ease: "power3" });

      const onMove = (e: MouseEvent) => {
        const r = stage.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        rx(-py * 14);
        ry(px * 18);
      };
      const onLeave = () => {
        rx(0);
        ry(0);
      };

      stage.addEventListener("mousemove", onMove);
      stage.addEventListener("mouseleave", onLeave);
      return () => {
        stage.removeEventListener("mousemove", onMove);
        stage.removeEventListener("mouseleave", onLeave);
        gsap.set(card, { rotationX: 0, rotationY: 0 });
      };
    }
  );

  // 3) Flotación suave en bucle — dispositivos sin hover (móvil/táctil)
  mm.add("(hover: none) and (prefers-reduced-motion: no-preference)", () => {
    const card = document.querySelector<HTMLElement>("[data-card]");
    if (!card) return;
    const tween = gsap.to(card, {
      y: -14,
      duration: 3.2,
      ease: "sine.inOut",
      repeat: -1,
      yoyo: true,
    });
    return () => tween.kill();
  });
</script>
