---
import TopBar from "./TopBar.astro";
import { demoUser } from "../../config/product";
import { formatDateEsMx } from "../../lib/format";
import { DEFAULT_NAME, emailFromName } from "../../lib/user";

const initial = demoUser.name.trim().charAt(0).toUpperCase();
const memberSince = formatDateEsMx(new Date(`${demoUser.memberSince}T00:00:00`));
const initialEmail = emailFromName(DEFAULT_NAME);
---

<section data-screen="perfil" hidden class="app-section" aria-hidden="true">
  <TopBar title="Perfil" />

  <div class="mx-auto w-full max-w-[560px] px-4 py-5">
    <!-- Datos del usuario -->
    <div class="rounded-2xl border border-border bg-surface p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="flex items-center gap-4">
        <span
          class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-accent font-display text-xl font-bold text-white"
          aria-hidden="true">{initial}</span
        >
        <div class="min-w-0">
          <p class="truncate font-roboto text-lg font-medium text-ink" data-profile-name>
            {demoUser.name}
          </p>
          <p class="mt-0.5 flex flex-wrap items-center gap-1.5 text-sm text-muted">
            <span class="truncate" data-profile-email>{initialEmail}</span>
            <span
              class="rounded-full bg-bg px-2 py-0.5 text-[0.6rem] font-medium uppercase tracking-wide text-muted"
              >Correo ficticio</span
            >
          </p>
        </div>
      </div>

      <dl class="mt-5 grid grid-cols-2 gap-3">
        <div class="rounded-xl bg-bg px-3 py-2.5">
          <dt class="text-[0.65rem] uppercase tracking-wide text-muted">Tipo de cuenta</dt>
          <dd class="font-roboto text-sm font-medium text-ink">{demoUser.accountType}</dd>
        </div>
        <div class="rounded-xl bg-bg px-3 py-2.5">
          <dt class="text-[0.65rem] uppercase tracking-wide text-muted">Estado</dt>
          <dd class="flex items-center gap-1.5 font-roboto text-sm font-medium text-emerald-600">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>{demoUser.status}
          </dd>
        </div>
        <div class="col-span-2 rounded-xl bg-bg px-3 py-2.5">
          <dt class="text-[0.65rem] uppercase tracking-wide text-muted">Cliente desde</dt>
          <dd class="font-roboto text-sm font-medium text-ink">{memberSince}</dd>
        </div>
      </dl>
    </div>

    <!-- Opciones -->
    <ul class="mt-4 flex flex-col overflow-hidden rounded-2xl border border-border bg-surface">
      <li>
        <a
          href="#/perfil/avisos"
          data-ripple
          class="relative flex min-h-14 w-full items-center justify-between gap-3 overflow-hidden px-4 py-3 text-left transition duration-200 hover:bg-bg"
        >
          <span class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-accent/10 text-accent">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z" />
                <path d="M9.5 12l1.7 1.7L15 10" />
              </svg>
            </span>
            <span class="font-roboto text-sm font-medium text-ink">Avisos y privacidad</span>
          </span>
          <svg
            class="h-4 w-4 shrink-0 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </a>
      </li>
      <li class="border-t border-border">
        <button
          type="button"
          data-open-name-sheet
          data-ripple
          class="relative flex min-h-14 w-full items-center justify-between gap-3 overflow-hidden px-4 py-3 text-left transition duration-200 hover:bg-bg"
        >
          <span class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-bg text-ink">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 20h4l10-10-4-4L4 16z" />
                <path d="M13.5 6.5l4 4" />
              </svg>
            </span>
            <span class="font-roboto text-sm font-medium text-ink">Cambiar mi nombre</span>
          </span>
          <svg
            class="h-4 w-4 shrink-0 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </li>
      <li class="border-t border-border">
        <button
          type="button"
          data-logout
          data-ripple
          class="relative flex min-h-14 w-full items-center justify-between gap-3 overflow-hidden px-4 py-3 text-left transition duration-200 hover:bg-bg"
        >
          <span class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-red-50 text-red-600">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <path d="M16 17l5-5-5-5" />
                <path d="M21 12H9" />
              </svg>
            </span>
            <span class="font-roboto text-sm font-medium text-ink">Cerrar sesión</span>
          </span>
          <svg
            class="h-4 w-4 shrink-0 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </li>
    </ul>

    <p class="mt-4 text-center text-xs text-muted">Los datos de este perfil son ficticios.</p>
  </div>
</section>

<script>
  import { initRipple } from "../../lib/ripple";
  import { emailFromName, getStoredName } from "../../lib/user";

  initRipple();

  const name = getStoredName();
  const nameEl = document.querySelector<HTMLElement>("[data-profile-name]");
  const emailEl = document.querySelector<HTMLElement>("[data-profile-email]");
  if (nameEl) nameEl.textContent = name;
  if (emailEl) emailEl.textContent = emailFromName(name);

  document.querySelector("[data-logout]")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("encredit:lock", { detail: { hash: "#/inicio" } }));
  });
</script>
