---
const items = [
  { key: "inicio", href: "#/inicio", label: "Inicio" },
  { key: "prestamo", href: "#/simulador", label: "Préstamo" },
  { key: "perfil", href: "#/perfil", label: "Perfil" },
] as const;
---

<nav data-app-nav aria-label="Navegación principal" class="app-nav">
  <ul class="app-nav-list">
    {
      items.map((item) => (
        <li class="app-nav-cell">
          <a
            href={item.href}
            data-nav={item.key}
            data-ripple
            class="nav-item relative overflow-hidden"
          >
            <span class="nav-pill">
              {item.key === "inicio" && (
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 11.5 12 4l8 7.5" />
                  <path d="M6 10.5V20h12v-9.5" />
                </svg>
              )}
              {item.key === "prestamo" && (
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="6" width="18" height="12" rx="2" />
                  <circle cx="12" cy="12" r="2.5" />
                  <path d="M7 12h.01M17 12h.01" />
                </svg>
              )}
              {item.key === "perfil" && (
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="8" r="4" />
                  <path d="M4 20a8 8 0 0 1 16 0" />
                </svg>
              )}
            </span>
            <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .app-nav {
    flex: 0 0 auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .app-nav-list {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    min-height: 4.25rem;
    margin: 0 auto;
    padding: 0;
    max-width: 560px;
    list-style: none;
  }

  .app-nav-cell {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
  }

  .nav-item {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: 48px;
    padding: 0.35rem 0.25rem;
    border-radius: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    min-width: 3.5rem;
    padding: 0 0.9rem;
    border-radius: 9999px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nav-label {
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1;
  }

  .nav-item[aria-current="page"] {
    color: var(--color-accent);
  }

  .nav-item[aria-current="page"] .nav-pill {
    background: var(--color-accent);
    color: #fff;
  }

  .nav-item[aria-current="page"] .nav-label {
    font-weight: 600;
  }

  /* Contenedor ancho: navigation rail lateral. */
  @container app (min-width: 600px) {
    .app-nav {
      width: 5.25rem;
      border-top: 0;
      border-right: 1px solid var(--color-border);
    }

    .app-nav-list {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.5rem;
      min-height: 100%;
      padding: 1rem 0.5rem;
      max-width: none;
    }

    .app-nav-cell {
      flex: 0 0 auto;
    }

    .nav-item {
      min-height: 3.5rem;
      padding: 0.5rem 0.25rem;
    }
  }
</style>
