<div
  data-frozen-notice
  hidden
  class="rounded-2xl border border-amber-200 bg-amber-50 p-4"
>
  <p class="flex items-start gap-2 text-sm leading-relaxed text-amber-800">
    <svg
      class="mt-0.5 h-4 w-4 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="4" y="10" width="16" height="10" rx="2" />
      <path d="M8 10V7a4 4 0 0 1 8 0v3" />
    </svg>
    Tu tarjeta está congelada. Descongélala para operar.
  </p>
  <button
    type="button"
    data-frozen-thaw
    data-ripple
    class="relative mt-3 inline-flex min-h-11 items-center justify-center overflow-hidden rounded-full bg-accent px-5 text-sm font-semibold text-white transition duration-200 hover:bg-accent-hover"
  >
    Descongelar
  </button>
</div>

<script>
  import { getState, subscribe, toggleFreeze } from "../../lib/account";
  import { initRipple } from "../../lib/ripple";

  initRipple();

  const notices = Array.from(document.querySelectorAll<HTMLElement>("[data-frozen-notice]"));
  const sync = () => {
    const frozen = getState().frozen;
    notices.forEach((notice) => {
      notice.hidden = !frozen;
    });
  };

  subscribe(sync);
  sync();

  document.querySelectorAll("[data-frozen-thaw]").forEach((button) => {
    button.addEventListener("click", () => toggleFreeze());
  });
</script>
