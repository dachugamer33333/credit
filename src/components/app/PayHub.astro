---
import TopBar from "./TopBar.astro";
import AppContent from "./AppContent.astro";

const items = [
  {
    href: "#/pagar/credito",
    title: "Pagar mi tarjeta",
    desc: "Abona a tu saldo y evita generar intereses.",
    icon: "card",
  },
  {
    href: "#/pagar/digital",
    title: "Pago digital (CVV dinámico)",
    desc: "Consulta tu tarjeta virtual y copia el CVV.",
    icon: "shield",
  },
  {
    href: "#/pagar/servicios",
    title: "Pagar servicios",
    desc: "CFE, agua, gas, teléfono e internet.",
    icon: "receipt",
  },
  {
    href: "#/pagar/recarga",
    title: "Recarga de tiempo aire",
    desc: "Telcel, AT&T, Movistar y más.",
    icon: "phone",
  },
];
---

<section data-screen="pagar-hub" hidden class="app-section" aria-hidden="true">
  <TopBar title="Pagar" backHref="#/inicio" backLabel="Volver al inicio" flush />

  <AppContent>
    <p class="text-sm text-muted">Elige qué quieres pagar. Todo es una simulación.</p>

    <div class="hub-grid mt-5 grid gap-3">
      {
        items.map((item) => (
          <a
            href={item.href}
            data-ripple
            class="relative flex min-h-24 items-start gap-4 overflow-hidden rounded-2xl border border-border bg-surface p-4 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition duration-200 hover:border-slate-300 hover:bg-bg"
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent">
              {item.icon === "card" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="6" width="18" height="12" rx="2" />
                  <path d="M3 10h18" />
                </svg>
              )}
              {item.icon === "shield" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z" />
                  <path d="M9.5 12l1.7 1.7L15 10" />
                </svg>
              )}
              {item.icon === "receipt" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" />
                  <path d="M9 8h6M9 12h6" />
                </svg>
              )}
              {item.icon === "phone" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="7" y="2" width="10" height="20" rx="2" />
                  <path d="M11 18h2" />
                </svg>
              )}
            </span>
            <span class="min-w-0">
              <span class="block font-roboto text-sm font-semibold text-ink">{item.title}</span>
              <span class="mt-1 block text-xs leading-snug text-muted">{item.desc}</span>
            </span>
          </a>
        ))
      }
    </div>
  </AppContent>
</section>

<style>
  @container app (min-width: 600px) {
    .hub-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
