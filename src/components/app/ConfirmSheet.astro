<div data-confirm-sheet hidden>
  <div
    class="fixed inset-0 z-[var(--z-sheet)] flex items-end justify-center bg-slate-900/40 p-3"
    data-confirm-backdrop
  >
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="confirm-title"
      class="w-full max-w-md rounded-3xl border border-border bg-surface p-6 shadow-[0_30px_80px_-20px_rgba(15,23,42,0.5)]"
    >
      <h2 id="confirm-title" data-confirm-title class="font-display text-lg font-bold text-ink">
        Confirma la operación
      </h2>
      <dl data-confirm-rows class="mt-4 flex flex-col gap-2.5 text-sm"></dl>
      <p class="mt-4 rounded-xl bg-amber-50 px-3 py-2 text-xs leading-relaxed text-amber-700">
        Operación simulada. No se mueve dinero real.
      </p>
      <div class="mt-4 flex gap-3">
        <button
          type="button"
          data-confirm-cancel
          data-ripple
          class="relative inline-flex min-h-12 flex-1 items-center justify-center overflow-hidden rounded-full border border-border px-5 text-sm font-semibold text-ink transition duration-200 hover:bg-slate-100"
        >
          Cancelar
        </button>
        <button
          type="button"
          data-confirm-ok
          data-ripple
          class="relative inline-flex min-h-12 flex-1 items-center justify-center overflow-hidden rounded-full bg-accent px-5 text-sm font-semibold text-white transition duration-200 hover:bg-accent-hover"
        >
          Confirmar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { settleConfirm } from "../../lib/confirm";
  import { initRipple } from "../../lib/ripple";

  initRipple();

  document.querySelector("[data-confirm-ok]")?.addEventListener("click", () => settleConfirm(true));
  document
    .querySelector("[data-confirm-cancel]")
    ?.addEventListener("click", () => settleConfirm(false));
  document.querySelector("[data-confirm-backdrop]")?.addEventListener("click", (event) => {
    if (event.target === event.currentTarget) settleConfirm(false);
  });
  document.addEventListener("keydown", (event) => {
    const sheet = document.querySelector<HTMLElement>("[data-confirm-sheet]");
    if (event.key === "Escape" && sheet && !sheet.hidden) settleConfirm(false);
  });
</script>
