---
interface Props {
  label?: string;
  class?: string;
  variant?: "demo" | "fixed";
}

const { label, class: className, variant = "demo" } = Astro.props;
const text =
  label ?? (variant === "fixed" ? "Condiciones del ejercicio académico" : "Dato de demostración");
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[0.65rem] font-medium leading-tight text-amber-700",
    className,
  ]}
>
  <svg
    class="h-3 w-3 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 11v5"></path>
    <path d="M12 8h.01"></path>
  </svg>
  {text}
</span>
