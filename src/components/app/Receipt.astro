---
import AppContent from "./AppContent.astro";
---

<section data-screen="comprobante" hidden class="app-section" aria-hidden="true">
  <AppContent class="flex flex-col items-center">
    <div data-receipt-content hidden class="w-full text-center">
      <svg
        data-receipt-check
        class="mx-auto h-16 w-16 text-emerald-500"
        viewBox="0 0 52 52"
        fill="none"
        aria-hidden="true"
      >
        <circle class="rc-circle" cx="26" cy="26" r="23" stroke="currentColor" stroke-width="3"></circle>
        <path class="rc-mark" d="M15 27l7 7 15-16" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>

      <h1
        data-screen-title
        tabindex="-1"
        data-tipo
        class="mt-4 font-display text-xl font-bold text-ink"
      >
        Operación
      </h1>
      <p data-monto class="mt-1 font-display text-3xl font-bold text-ink"></p>

      <dl class="mt-6 flex flex-col gap-2.5 rounded-2xl border border-border bg-surface p-4 text-left text-sm">
        <div class="flex items-start justify-between gap-3">
          <dt class="text-muted">Concepto</dt>
          <dd data-concepto class="text-right font-roboto font-medium text-ink"></dd>
        </div>
        <div class="flex items-start justify-between gap-3">
          <dt class="text-muted">Fecha y hora</dt>
          <dd data-receipt-fecha class="text-right font-roboto font-medium text-ink"></dd>
        </div>
        <div class="flex items-start justify-between gap-3">
          <dt class="text-muted">Folio</dt>
          <dd data-folio class="text-right font-mono font-medium text-ink"></dd>
        </div>
      </dl>

      <div
        data-receipt-detalles
        hidden
        class="mt-3 flex flex-col gap-2.5 rounded-2xl border border-border bg-surface p-4 text-left text-sm"
      ></div>

      <p class="mt-4 text-xs text-muted">Operación simulada. No se movió dinero real.</p>

      <div class="mt-6 flex flex-col gap-2">
        <button
          type="button"
          data-share
          data-ripple
          class="relative flex min-h-12 items-center justify-center gap-2 overflow-hidden rounded-full bg-accent px-6 text-sm font-semibold text-white transition duration-200 hover:bg-accent-hover"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
            <path d="M12 16V3" />
            <path d="M8 7l4-4 4 4" />
          </svg>
          Compartir comprobante
        </button>

        <a
          href="#/inicio"
          data-ripple
          class="relative flex min-h-12 items-center justify-center overflow-hidden rounded-full border border-border px-6 text-sm font-semibold text-ink transition duration-200 hover:bg-slate-100"
        >
          Listo
        </a>

        <div class="mt-1 flex items-center justify-center gap-4 text-sm">
          <a href="#/historial" class="font-medium text-accent">Ver historial</a>
          <span class="text-border" aria-hidden="true">·</span>
          <a href="#/pagar" class="font-medium text-accent">Hacer otra operación</a>
        </div>
      </div>
    </div>
  </AppContent>
</section>

<script>
  import { getReceipt, type ReceiptData } from "../../lib/receipt";
  import { formatDateEsMx, formatMXN } from "../../lib/format";
  import { showSnackbar } from "../../lib/snackbar";
  import { initRipple } from "../../lib/ripple";

  initRipple();

  const root = document.querySelector<HTMLElement>('[data-screen="comprobante"]');
  const content = root?.querySelector<HTMLElement>("[data-receipt-content]");
  const shareBtn = root?.querySelector<HTMLButtonElement>("[data-share]");

  const fechaLarga = (iso: string): string =>
    formatDateEsMx(new Date(iso), {
      day: "numeric",
      month: "long",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

  const renderReceipt = () => {
    if (window.location.hash !== "#/comprobante") return;
    const data = getReceipt();
    if (!data) {
      window.location.replace("#/inicio");
      return;
    }

    const set = (selector: string, text: string) => {
      const el = root?.querySelector<HTMLElement>(selector);
      if (el) el.textContent = text;
    };

    set("[data-tipo]", data.tipo);
    set("[data-monto]", formatMXN(data.monto, 2));
    set("[data-concepto]", data.concepto);
    set("[data-receipt-fecha]", fechaLarga(data.fecha));
    set("[data-folio]", data.folio);

    const detalleWrap = root?.querySelector<HTMLElement>("[data-receipt-detalles]");
    if (detalleWrap) {
      const detalles = data.detalles ?? [];
      detalleWrap.hidden = detalles.length === 0;
      detalleWrap.replaceChildren(
        ...detalles.map(({ label, value }) => {
          const row = document.createElement("div");
          row.className = "flex items-start justify-between gap-3";
          const dt = document.createElement("span");
          dt.className = "text-muted";
          dt.textContent = label;
          const dd = document.createElement("span");
          dd.className = "text-right font-roboto font-medium text-ink";
          dd.textContent = value;
          row.append(dt, dd);
          return row;
        })
      );
    }

    if (content) content.hidden = false;

    const check = root?.querySelector<SVGElement>("[data-receipt-check]");
    if (check) {
      check.classList.remove("rc-run");
      void check.getBoundingClientRect();
      check.classList.add("rc-run");
    }
  };

  window.addEventListener("hashchange", renderReceipt);
  renderReceipt();

  const shareText = (data: ReceiptData): string => {
    const lines = [
      "Comprobante EN CREDIT",
      data.tipo,
      `Monto: ${formatMXN(data.monto, 2)}`,
      `Concepto: ${data.concepto}`,
      `Fecha: ${fechaLarga(data.fecha)}`,
      `Folio: ${data.folio}`,
    ];
    for (const detalle of data.detalles ?? []) lines.push(`${detalle.label}: ${detalle.value}`);
    lines.push("Operación simulada. No se movió dinero real.");
    return lines.join("\n");
  };

  const drawReceiptImage = async (data: ReceiptData): Promise<Blob | null> => {
    const baseRows: Array<[string, string]> = [
      ["Concepto", data.concepto],
      ["Fecha y hora", fechaLarga(data.fecha)],
      ["Folio", data.folio],
    ];
    const detalleRows: Array<[string, string]> = (data.detalles ?? []).map((d) => [d.label, d.value]);
    const rows = [...baseRows, ...detalleRows];

    const W = 720;
    const H = 720 + rows.length * 68;
    const canvas = document.createElement("canvas");
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext("2d");
    if (!ctx) return null;

    const roundRect = (x: number, y: number, w: number, h: number, r: number) => {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    };

    if (document.fonts?.ready) {
      try {
        await document.fonts.ready;
      } catch {
        /* sin fuentes web: usa fallback */
      }
    }

    ctx.fillStyle = "#F6F7F9";
    ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = "#FFFFFF";
    roundRect(40, 40, W - 80, H - 80, 32);
    ctx.fill();

    ctx.textBaseline = "alphabetic";
    ctx.fillStyle = "#0F172A";
    ctx.font = "700 30px Syne, Arial, sans-serif";
    ctx.fillText("EN CREDIT", 80, 120);
    ctx.font = "700 42px 'Noto Serif JP', serif";
    ctx.fillText("縁", W - 150, 120);

    const lineY = 140;
    const lineW = 210;
    const colors = ["#2563EB", "#EF4444", "#F59E0B"];
    colors.forEach((color, i) => {
      ctx.fillStyle = color;
      ctx.fillRect(80 + i * (lineW / 3), lineY, lineW / 3, 5);
    });

    ctx.strokeStyle = "#16A34A";
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.arc(W / 2, 290, 54, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(W / 2 - 24, 292);
    ctx.lineTo(W / 2 - 6, 312);
    ctx.lineTo(W / 2 + 30, 274);
    ctx.stroke();

    ctx.textAlign = "center";
    ctx.fillStyle = "#0F172A";
    ctx.font = "700 36px Roboto, Arial, sans-serif";
    ctx.fillText("Pago exitoso", W / 2, 400);
    ctx.fillStyle = "#64748B";
    ctx.font = "500 22px Roboto, Arial, sans-serif";
    ctx.fillText(data.tipo, W / 2, 440);
    ctx.fillStyle = "#0F172A";
    ctx.font = "700 58px Syne, Arial, sans-serif";
    ctx.fillText(formatMXN(data.monto, 2), W / 2, 510);
    ctx.textAlign = "left";

    let ry = 620;
    for (const [label, value] of rows) {
      ctx.fillStyle = "#64748B";
      ctx.font = "500 22px Roboto, Arial, sans-serif";
      ctx.fillText(label, 80, ry);
      ctx.fillStyle = "#0F172A";
      ctx.textAlign = "right";
      ctx.fillText(value, W - 80, ry);
      ctx.textAlign = "left";
      ry += 34;
      ctx.strokeStyle = "#E5E7EB";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(80, ry - 12);
      ctx.lineTo(W - 80, ry - 12);
      ctx.stroke();
      ry += 34;
    }

    ctx.textAlign = "center";
    ctx.fillStyle = "#64748B";
    ctx.font = "400 20px Roboto, Arial, sans-serif";
    ctx.fillText("Operación simulada. No se movió dinero real.", W / 2, H - 110);

    return new Promise((resolve) => {
      canvas.toBlob((blob) => resolve(blob), "image/png");
    });
  };

  const downloadBlob = (blob: Blob, filename: string) => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  };

  shareBtn?.addEventListener("click", async () => {
    const data = getReceipt();
    if (!data) return;
    const text = shareText(data);
    const filename = `comprobante-${data.folio}.png`;

    let file: File | null = null;
    try {
      const blob = await drawReceiptImage(data);
      if (blob) file = new File([blob], filename, { type: "image/png" });
    } catch {
      file = null;
    }

    if (file && navigator.canShare?.({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: "Comprobante EN CREDIT", text });
        return;
      } catch (error) {
        if ((error as DOMException)?.name === "AbortError") return;
      }
    }

    if (file) {
      downloadBlob(file, filename);
      showSnackbar("Comprobante descargado");
      return;
    }

    try {
      if (navigator.share) {
        await navigator.share({ title: "Comprobante EN CREDIT", text });
        return;
      }
      await navigator.clipboard.writeText(text);
      showSnackbar("Comprobante copiado");
    } catch {
      showSnackbar("No se pudo compartir");
    }
  });
</script>

<style>
  .rc-circle {
    stroke-dasharray: 145;
    stroke-dashoffset: 145;
  }

  .rc-mark {
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
  }

  .rc-run .rc-circle {
    animation: rc-circle 0.5s ease-out forwards;
  }

  .rc-run .rc-mark {
    animation: rc-mark 0.3s ease-out 0.35s forwards;
  }

  @keyframes rc-circle {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes rc-mark {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rc-run .rc-circle,
    .rc-run .rc-mark {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
