---
import CreditCard from "../CreditCard.astro";
import TopBar from "./TopBar.astro";
import DemoTag from "./DemoTag.astro";
import { credit } from "../../config/product";
import { formatDateEsMx, formatMXN, getNextPaymentDate } from "../../lib/format";

const available = formatMXN(credit.available);
const limit = formatMXN(credit.limit);
const used = formatMXN(credit.used);
const usagePct = Math.round((credit.used / credit.limit) * 100);

const nextPayment = getNextPaymentDate(new Date(), credit.paymentDay);
const nextPaymentLabel = formatDateEsMx(nextPayment);
const nextPaymentAmount = formatMXN(credit.nextPaymentAmount);
---

<section data-screen="inicio" class="app-section" aria-hidden="false">
  <TopBar brand />

  <div class="mx-auto w-full max-w-[560px] px-4 py-5">
    <div class="home-grid">
      <!-- Columna izquierda: tarjeta y acciones -->
      <div>
        <div class="flex items-end justify-between gap-2">
          <h2 data-greeting class="font-roboto text-xl font-medium text-ink">Buenas tardes, Juan</h2>
        </div>

        <div class="home-card-holder relative mt-4" data-freeze-wrap data-frozen="false">
          <CreditCard variant="app" name="JUAN PÉREZ" />
          <div
            class="frozen-overlay absolute inset-0 grid place-items-center rounded-[1.25rem] bg-slate-900/35 text-white"
            aria-hidden="true"
          >
            <span class="flex flex-col items-center gap-1.5">
              <svg
                class="h-7 w-7"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="4" y="10" width="16" height="10" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
              </svg>
              <span class="text-xs font-semibold">Tarjeta congelada</span>
            </span>
          </div>
        </div>

        <!-- Crédito disponible -->
        <div class="mt-5">
          <div class="flex items-end justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-[0.16em] text-muted">Crédito disponible</p>
              <p data-available class="font-display text-3xl font-bold leading-tight text-ink">
                {available}
              </p>
            </div>
            <div class="text-right">
              <p class="text-xs uppercase tracking-[0.16em] text-muted">Límite</p>
              <p class="font-roboto text-sm font-medium text-ink">{limit}</p>
            </div>
          </div>
          <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-slate-200">
            <span
              data-usage-bar
              class="block h-full rounded-full bg-accent"
              style={`width:${usagePct}%`}
              role="progressbar"
              aria-valuenow={usagePct}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-label={`Uso del crédito: ${usagePct}%`}
            ></span>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <span class="text-xs text-muted">Usado: <span data-used>{used}</span></span>
            <DemoTag />
          </div>
        </div>

        <!-- Acciones -->
        <div class="mt-6 grid grid-cols-3 gap-3">
          <button
            type="button"
            data-action="pagar"
            data-ripple
            class="action-btn relative overflow-hidden"
          >
            <span class="action-ic bg-accent text-white">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 7h16v10H4z" />
                <path d="M4 11h16" />
              </svg>
            </span>
            <span class="action-label">Pagar</span>
          </button>

          <button
            type="button"
            data-action="transferir"
            data-ripple
            class="action-btn relative overflow-hidden"
          >
            <span class="action-ic bg-red-500 text-white">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 8h13l-3-3" />
                <path d="M20 16H7l3 3" />
              </svg>
            </span>
            <span class="action-label">Transferir</span>
          </button>

          <button
            type="button"
            data-action="congelar"
            data-ripple
            aria-pressed="false"
            class="action-btn relative overflow-hidden"
          >
            <span class="action-ic bg-amber-400 text-slate-900">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3v18" />
                <path d="M4.2 7.5l15.6 9" />
                <path d="M19.8 7.5 4.2 16.5" />
              </svg>
            </span>
            <span class="action-label" data-freeze-label>Congelar</span>
          </button>
        </div>

        <p data-freeze-live class="sr-only" aria-live="polite"></p>
      </div>

      <!-- Columna derecha: pago, resumen y atajo -->
      <div class="flex flex-col gap-4">
        <!-- Próximo pago -->
        <div class="rounded-2xl border border-border bg-surface p-4 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
          <div class="flex items-center justify-between">
            <h3 class="font-roboto text-sm font-medium text-ink">Próximo pago</h3>
            <DemoTag />
          </div>
          <div class="mt-3 flex items-end justify-between">
            <div>
              <p class="text-xs text-muted">Fecha</p>
              <p data-next-payment class="font-roboto text-base font-medium text-ink">
                {nextPaymentLabel}
              </p>
            </div>
            <div class="text-right">
              <p class="text-xs text-muted">Monto</p>
              <p class="font-display text-lg font-bold text-ink">{nextPaymentAmount}</p>
            </div>
          </div>
        </div>

        <!-- Resumen de la cuenta -->
        <div class="rounded-2xl border border-border bg-surface p-4 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
          <div class="flex items-center justify-between">
            <h3 class="font-roboto text-sm font-medium text-ink">Resumen de la cuenta</h3>
            <DemoTag />
          </div>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl bg-bg px-2 py-2">
              <dt class="text-[0.65rem] uppercase tracking-wide text-muted">Límite</dt>
              <dd class="font-roboto text-sm font-semibold text-ink">{limit}</dd>
            </div>
            <div class="rounded-xl bg-bg px-2 py-2">
              <dt class="text-[0.65rem] uppercase tracking-wide text-muted">Usado</dt>
              <dd data-summary-used class="font-roboto text-sm font-semibold text-ink">{used}</dd>
            </div>
            <div class="rounded-xl bg-bg px-2 py-2">
              <dt class="text-[0.65rem] uppercase tracking-wide text-muted">Disponible</dt>
              <dd data-summary-available class="font-roboto text-sm font-semibold text-ink">
                {available}
              </dd>
            </div>
          </dl>

          <div class="mt-4 flex items-center justify-between gap-2">
            <h4 class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">
              Movimientos recientes
            </h4>
            <a href="#/historial" class="shrink-0 text-xs font-medium text-accent">Ver historial</a>
          </div>
          <ul data-movements class="mt-2 flex flex-col divide-y divide-border"></ul>
        </div>

        <!-- Atajo al simulador -->
        <a
          href="#/simulador"
          data-ripple
          class="relative flex items-center justify-between overflow-hidden rounded-2xl border border-accent/30 bg-accent/10 px-4 py-3.5 text-accent transition duration-200 hover:bg-accent/15"
        >
          <span class="font-roboto text-sm font-semibold">Simular un préstamo</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @container app (min-width: 700px) {
    .home-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      align-items: start;
    }
  }

  .frozen-overlay {
    display: none;
  }

  [data-frozen="true"] .frozen-overlay {
    display: grid;
  }

  [data-frozen="true"] .home-card-holder {
    opacity: 0.5;
    filter: grayscale(0.25);
  }

  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-height: 56px;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .action-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
  }

  .action-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Celular horizontal: la tarjeta reduce su altura. */
  @media (orientation: landscape) and (max-height: 480px) {
    .home-card-holder {
      max-width: 15rem;
      margin-inline: auto;
    }
  }
</style>

<script>
  import { initRipple } from "../../lib/ripple";
  import { showSnackbar } from "../../lib/snackbar";
  import { buildGreeting, getStoredName } from "../../lib/user";
  import { formatDateEsMx, formatMXN, getNextPaymentDate } from "../../lib/format";
  import { credit } from "../../config/product";
  import {
    getState,
    subscribe,
    toggleFreeze,
    type AccountMovement,
    type AccountState,
  } from "../../lib/account";

  initRipple();

  // Saludo con la hora local del dispositivo.
  const greeting = document.querySelector<HTMLElement>("[data-greeting]");
  if (greeting) greeting.textContent = buildGreeting(getStoredName());

  // Fecha de próximo pago recalculada con la fecha actual.
  const nextPayment = document.querySelector<HTMLElement>("[data-next-payment]");
  if (nextPayment) {
    nextPayment.textContent = formatDateEsMx(getNextPaymentDate(new Date(), credit.paymentDay));
  }

  const freezeBtn = document.querySelector<HTMLElement>('[data-action="congelar"]');
  const freezeLabel = document.querySelector<HTMLElement>("[data-freeze-label]");
  const freezeLive = document.querySelector<HTMLElement>("[data-freeze-live]");
  const wrap = document.querySelector<HTMLElement>("[data-freeze-wrap]");
  const availableEl = document.querySelector<HTMLElement>("[data-available]");
  const usedEl = document.querySelector<HTMLElement>("[data-used]");
  const summaryUsed = document.querySelector<HTMLElement>("[data-summary-used]");
  const summaryAvailable = document.querySelector<HTMLElement>("[data-summary-available]");
  const usageBar = document.querySelector<HTMLElement>("[data-usage-bar]");
  const movementsEl = document.querySelector<HTMLElement>("[data-movements]");

  const renderMovements = (movimientos: AccountMovement[]) => {
    if (!movementsEl) return;
    movementsEl.replaceChildren(
      ...movimientos.slice(0, 3).map((m) => {
        const abono = m.tipo === "pago";
        const li = document.createElement("li");
        li.className = "flex items-center justify-between gap-3 py-2.5";

        const left = document.createElement("span");
        left.className = "min-w-0";
        const concepto = document.createElement("span");
        concepto.className = "block truncate font-roboto text-sm text-ink";
        concepto.textContent = m.concepto;
        const fecha = document.createElement("span");
        fecha.className = "block text-xs text-muted";
        fecha.textContent = formatDateEsMx(new Date(m.fecha), { day: "numeric", month: "short" });
        left.append(concepto, fecha);

        const amount = document.createElement("span");
        amount.className = `shrink-0 font-roboto text-sm font-semibold ${
          abono ? "text-emerald-600" : "text-ink"
        }`;
        amount.textContent = `${abono ? "+" : "−"}${formatMXN(m.monto)}`;

        li.append(left, amount);
        return li;
      })
    );
  };

  const render = (snapshot: AccountState) => {
    const usado = snapshot.usado;
    const disp = credit.limit - usado;
    const pct = Math.min(100, Math.round((usado / credit.limit) * 100));

    if (availableEl) availableEl.textContent = formatMXN(disp);
    if (usedEl) usedEl.textContent = formatMXN(usado);
    if (summaryUsed) summaryUsed.textContent = formatMXN(usado);
    if (summaryAvailable) summaryAvailable.textContent = formatMXN(disp);
    if (usageBar) {
      usageBar.style.width = `${pct}%`;
      usageBar.setAttribute("aria-valuenow", String(pct));
      usageBar.setAttribute("aria-label", `Uso del crédito: ${pct}%`);
    }

    if (wrap) wrap.setAttribute("data-frozen", String(snapshot.frozen));
    if (freezeBtn) freezeBtn.setAttribute("aria-pressed", String(snapshot.frozen));
    if (freezeLabel) freezeLabel.textContent = snapshot.frozen ? "Descongelar" : "Congelar";

    renderMovements(snapshot.movimientos);
  };

  subscribe(render);
  render(getState());

  freezeBtn?.addEventListener("click", () => {
    const frozen = toggleFreeze();
    if (freezeLive) freezeLive.textContent = frozen ? "Tarjeta congelada" : "Tarjeta activa";
  });

  document.querySelector('[data-action="pagar"]')?.addEventListener("click", () => {
    window.location.hash = "#/pagar";
  });

  document.querySelector('[data-action="transferir"]')?.addEventListener("click", () => {
    showSnackbar("Función demostrativa: no incluida en este prototipo");
  });
</script>
