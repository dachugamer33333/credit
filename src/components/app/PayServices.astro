---
import TopBar from "./TopBar.astro";
import DemoTag from "./DemoTag.astro";
import FrozenNotice from "./FrozenNotice.astro";
import AppContent from "./AppContent.astro";
import { serviceCategories, services } from "../../config/services";

const initials = (nombre: string): string =>
  nombre.replace(/[^A-Za-zÁÉÍÓÚÑ&]/g, "").slice(0, 2).toUpperCase();
---

<section data-screen="pagar-servicios" hidden class="app-section" aria-hidden="true">
  <TopBar title="Pagar servicios" backHref="#/pagar" backLabel="Volver a Pagar" flush />

  <AppContent>
    <FrozenNotice />

    <!-- Paso 1: elegir servicio -->
    <div class="mt-5">
      <h3 class="font-roboto text-sm font-medium text-ink">1. Elige el servicio</h3>
      <div class="mt-2 flex flex-wrap gap-2" data-cats>
        <button type="button" data-cat="all" class="cat-chip" aria-pressed="true">Todas</button>
        {
          serviceCategories.map((cat) => (
            <button type="button" data-cat={cat} class="cat-chip" aria-pressed="false">
              {cat}
            </button>
          ))
        }
      </div>

      <div class="mt-3 grid grid-cols-2 gap-2">
        {
          services.map((service) => (
            <button
              type="button"
              data-service={service.id}
              data-servcat={service.categoria}
              class="service-btn flex min-h-16 items-center gap-3 rounded-xl border border-border bg-surface p-3 text-left transition duration-200 hover:bg-bg"
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent/10 font-roboto text-xs font-semibold text-accent">
                {initials(service.nombre)}
              </span>
              <span class="min-w-0">
                <span class="block truncate font-roboto text-sm font-medium text-ink">
                  {service.nombre}
                </span>
                <span class="block truncate text-[0.65rem] text-muted">{service.categoria}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Paso 2: referencia -->
    <div class="mt-5">
      <h3 class="font-roboto text-sm font-medium text-ink">2. Ingresa tu referencia</h3>
      <p data-selected class="mt-1 text-xs text-muted">Selecciona un servicio para continuar.</p>
      <label class="sr-only" for="servicio-ref">Referencia</label>
      <input
        id="servicio-ref"
        data-ref
        type="text"
        inputmode="numeric"
        autocomplete="off"
        disabled
        placeholder="Solo dígitos"
        class="mt-2 min-h-11 w-full rounded-xl border border-border bg-white px-4 text-base tracking-wider text-ink disabled:bg-bg"
      />
      <div class="mt-1 flex items-center justify-between gap-2 text-xs text-muted">
        <span data-ref-help>Elige un servicio.</span>
        <span data-ref-count>0 dígitos</span>
      </div>
      <button
        type="button"
        data-ref-example
        disabled
        class="mt-2 text-sm font-medium text-accent disabled:text-muted"
      >
        Usar referencia de ejemplo
      </button>

      <button
        type="button"
        data-consult
        disabled
        data-ripple
        class="relative mt-3 flex min-h-12 w-full items-center justify-center overflow-hidden rounded-full bg-accent px-6 text-sm font-semibold text-white transition duration-200 hover:bg-accent-hover disabled:bg-slate-300"
      >
        Consultar adeudo
      </button>
    </div>

    <!-- Paso 3: resultado -->
    <div data-result hidden class="mt-5 rounded-2xl border border-border bg-surface p-4">
      <div class="flex items-center justify-between gap-2">
        <h3 class="font-roboto text-sm font-medium text-ink">Adeudo encontrado</h3>
        <DemoTag label="Adeudo de demostración" />
      </div>
      <dl class="mt-3 flex flex-col gap-2.5 text-sm">
        <div class="flex items-center justify-between gap-3">
          <dt class="text-muted">Servicio</dt>
          <dd data-r-service class="font-roboto font-medium text-ink"></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-muted">Referencia</dt>
          <dd data-r-ref class="font-mono text-ink"></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-muted">Vencimiento</dt>
          <dd data-r-due class="font-roboto font-medium text-ink"></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-muted">Importe</dt>
          <dd data-r-amount class="font-display text-xl font-bold text-ink"></dd>
        </div>
      </dl>

      <p data-error hidden class="mt-3 text-sm font-medium text-red-600"></p>

      <button
        type="button"
        data-pay
        data-ripple
        class="relative mt-4 flex min-h-12 w-full items-center justify-center overflow-hidden rounded-full bg-accent px-6 text-sm font-semibold text-white transition duration-200 hover:bg-accent-hover disabled:bg-slate-300"
      >
        Pagar
      </button>
    </div>
  </AppContent>
</section>

<style>
  .cat-chip {
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .cat-chip[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .service-btn[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 8%, transparent);
  }
</style>

<script>
  import { charge, disponible, subscribe } from "../../lib/account";
  import { openConfirm } from "../../lib/confirm";
  import { setReceipt } from "../../lib/receipt";
  import { adeudoPorReferencia, folio8 } from "../../lib/payments";
  import { formatDateEsMx, formatMXN, getNextPaymentDate } from "../../lib/format";
  import { services } from "../../config/services";
  import { initRipple } from "../../lib/ripple";

  initRipple();

  const catButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-cat]"));
  const serviceButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-service]"));
  const selectedEl = document.querySelector<HTMLElement>("[data-selected]");
  const refInput = document.querySelector<HTMLInputElement>("[data-ref]");
  const refHelp = document.querySelector<HTMLElement>("[data-ref-help]");
  const refCount = document.querySelector<HTMLElement>("[data-ref-count]");
  const exampleBtn = document.querySelector<HTMLButtonElement>("[data-ref-example]");
  const consultBtn = document.querySelector<HTMLButtonElement>("[data-consult]");
  const result = document.querySelector<HTMLElement>("[data-result]");
  const errorEl = document.querySelector<HTMLElement>("[data-error]");
  const payBtn = document.querySelector<HTMLButtonElement>("[data-pay]");

  let selected = services[0];
  let adeudo = 0;

  const serviceById = (id: string) => services.find((s) => s.id === id) ?? services[0];

  const filterCategory = (cat: string) => {
    catButtons.forEach((btn) => btn.setAttribute("aria-pressed", String(btn.dataset.cat === cat)));
    serviceButtons.forEach((btn) => {
      btn.hidden = cat !== "all" && btn.dataset.servcat !== cat;
    });
  };

  const selectService = (id: string) => {
    selected = serviceById(id);
    serviceButtons.forEach((btn) => btn.setAttribute("aria-pressed", String(btn.dataset.service === id)));
    if (selectedEl) selectedEl.textContent = `${selected.nombre} · ${selected.ayuda}`;
    if (refInput) {
      refInput.disabled = false;
      refInput.maxLength = selected.longitudReferencia;
      refInput.value = "";
    }
    if (refHelp) refHelp.textContent = `Referencia de ${selected.longitudReferencia} dígitos.`;
    if (exampleBtn) exampleBtn.disabled = false;
    if (result) result.hidden = true;
    const n = refInput?.value.length ?? 0;
    if (refCount) refCount.textContent = `${n} de ${selected.longitudReferencia} dígitos`;
    updateConsult();
  };

  const referenceReady = () =>
    !!refInput && refInput.value.length === selected.longitudReferencia;

  const updateConsult = () => {
    if (consultBtn) consultBtn.disabled = !referenceReady();
    const n = refInput?.value.length ?? 0;
    if (refCount && refInput && !refInput.disabled) {
      refCount.textContent = `${n} de ${selected.longitudReferencia} dígitos`;
    }
  };

  catButtons.forEach((btn) => btn.addEventListener("click", () => filterCategory(btn.dataset.cat ?? "all")));
  serviceButtons.forEach((btn) =>
    btn.addEventListener("click", () => selectService(btn.dataset.service ?? ""))
  );

  refInput?.addEventListener("input", () => {
    refInput.value = refInput.value.replace(/\D/g, "").slice(0, selected.longitudReferencia);
    if (result) result.hidden = true;
    updateConsult();
  });

  exampleBtn?.addEventListener("click", () => {
    let value = "";
    for (let i = 0; i < selected.longitudReferencia; i++) {
      value += String(Math.floor(Math.random() * 10));
    }
    if (refInput) {
      refInput.value = value;
      updateConsult();
    }
  });

  consultBtn?.addEventListener("click", () => {
    if (!refInput || !referenceReady()) return;
    consultBtn.disabled = true;
    const original = consultBtn.textContent;
    consultBtn.textContent = "Consultando…";

    window.setTimeout(() => {
      consultBtn.textContent = original;
      adeudo = adeudoPorReferencia(refInput.value);
      const serviceName = selected.nombre;
      const ref = refInput.value;

      const setText = (sel: string, text: string) => {
        const el = document.querySelector<HTMLElement>(sel);
        if (el) el.textContent = text;
      };
      setText("[data-r-service]", serviceName);
      setText("[data-r-ref]", ref);
      setText("[data-r-due]", formatDateEsMx(getNextPaymentDate(new Date(), 15)));
      setText("[data-r-amount]", formatMXN(adeudo, 2));

      const exceed = adeudo > disponible();
      if (errorEl) {
        errorEl.hidden = !exceed;
        errorEl.textContent = exceed ? "Excede tu crédito disponible" : "";
      }
      if (payBtn) {
        payBtn.disabled = exceed;
        payBtn.textContent = `Pagar ${formatMXN(adeudo, 2)}`;
      }
      if (result) result.hidden = false;
      updateConsult();
    }, 600);
  });

  payBtn?.addEventListener("click", async () => {
    if (!refInput || adeudo <= 0) return;
    const serviceName = selected.nombre;
    const ref = refInput.value;
    const exceed = adeudo > disponible();
    if (exceed) return;

    const ok = await openConfirm({
      title: "Confirmar pago de servicio",
      rows: [
        { label: "Servicio", value: `${serviceName} · ${ref}` },
        { label: "Importe", value: formatMXN(adeudo, 2) },
      ],
      confirmLabel: `Pagar ${formatMXN(adeudo, 2)}`,
    });
    if (!ok) return;

    const res = charge(adeudo, `${serviceName} · ${ref}`, "servicio");
    if (!res.ok) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = res.error === "frozen" ? "Tu tarjeta está congelada." : "Excede tu crédito disponible";
      }
      return;
    }

    setReceipt({
      tipo: "Pago de servicio",
      monto: adeudo,
      concepto: `${serviceName} · Ref ${ref}`,
      fecha: new Date().toISOString(),
      folio: folio8(),
    });
    window.location.replace("#/comprobante");
  });

  subscribe(() => {
    if (result && !result.hidden && adeudo > 0) {
      const exceed = adeudo > disponible();
      if (errorEl) {
        errorEl.hidden = !exceed;
        errorEl.textContent = exceed ? "Excede tu crédito disponible" : "";
      }
      if (payBtn) payBtn.disabled = exceed;
    }
  });

  filterCategory("all");
  selectService(services[0].id);
</script>
