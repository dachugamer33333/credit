---
import TopBar from "./TopBar.astro";
import DemoTag from "./DemoTag.astro";
import {
  contractReca,
  fixedTerms,
  privacyExampleText,
  recaNumber,
  recas,
} from "../../config/product";
import { formatMXN, formatPercent } from "../../lib/format";
import { interesMoratorio } from "../../lib/credit-terms";
import { buildLoan } from "../../lib/loan";
import { legalMeta } from "../../data/legal/meta";
import { compiledContent as contratoContent } from "../../data/legal/contrato.md";
import { compiledContent as disposicionesContent } from "../../data/legal/disposiciones.md";
import { existsSync } from "node:fs";
import { join } from "node:path";

const moraRows = fixedTerms.diasMoraEjemplo.map((dias) => {
  const mora = interesMoratorio(fixedTerms.capitalVencidoEjemplo, dias);
  return {
    dias,
    mora: formatMXN(mora, 2),
    total: formatMXN(fixedTerms.pagoVencidoEjemplo + mora, 2),
  };
});

// Apartado 4: condiciones y amortización del caso base (fixedTerms, método plano).
const baseLoan = buildLoan({
  monto: fixedTerms.monto,
  plazo: fixedTerms.plazoMeses,
  tasaMensualSimple: fixedTerms.tasaOrdinariaMensualSimple / 100,
  comisionApertura: fixedTerms.comisionApertura,
});
const scheduleRows = baseLoan.tabla.map((fila) => ({
  mes: fila.mes,
  saldoInicial: formatMXN(fila.saldoInicial, 2),
  capital: formatMXN(fila.capital, 2),
  interes: formatMXN(fila.interes, 2),
  pago: formatMXN(fila.pago, 2),
  saldoFinal: formatMXN(fila.saldoFinal, 2),
}));
const pagosTexto = `Cinco pagos de ${formatMXN(fixedTerms.pagoMensual1a5, 2)} y uno de ${formatMXN(
  fixedTerms.pagoMensual6,
  2
)}`;

interface DocSection {
  title: string;
  body: string;
}

// Parte el HTML renderizado (build-time) por <h2> para sub-acordeones sin JS.
const splitByH2 = (html: string): { intro: string; sections: DocSection[] } => {
  const parts = html.split(/<h2[^>]*>/i);
  const intro = parts.shift() ?? "";
  const items = parts.map((chunk) => {
    const close = chunk.indexOf("</h2>");
    const title = (close >= 0 ? chunk.slice(0, close) : chunk)
      .replace(/<[^>]+>/g, "")
      .trim();
    const body = close >= 0 ? chunk.slice(close + "</h2>".length) : "";
    return { title, body };
  });
  return { intro, sections: items };
};

const contrato = splitByH2(await contratoContent());
const disposiciones = await disposicionesContent();
const hasContractPdf = existsSync(join(process.cwd(), "public", "legal", "contrato.pdf"));

const sections = [
  { id: "tasas", title: "Tasas de interés aplicables", kind: "rates" },
  { id: "cat", title: "CAT (Costo Anual Total)", kind: "cat" },
  { id: "comisiones", title: "Comisiones y otros cargos", kind: "fees" },
  { id: "plazos", title: "Plazos, pagos y condiciones del producto", kind: "schedule" },
  {
    id: "privacidad",
    title: "Aviso de privacidad y tratamiento de datos personales",
    kind: "privacy",
  },
  { id: "reca", title: "Contrato de adhesión (RECA)", kind: "contract" },
  { id: "recas", title: "RECAS", kind: "registry", data: recas },
  { id: "disposiciones", title: "Disposiciones legales aplicables", kind: "legal" },
] as const;
---

<section data-screen="avisos" hidden class="app-section" aria-hidden="true">
  <TopBar
    title="Avisos y privacidad"
    backHref="#/perfil"
    backLabel="Volver a perfil"
    homeHref="#/inicio"
  />

  <div class="mx-auto w-full max-w-[560px] px-4 py-5">
    <div class="flex flex-col gap-2" data-accordion>
      {
        sections.map((section, index) => (
          <div class="overflow-hidden rounded-2xl border border-border bg-surface">
            <h2>
              <button
                type="button"
                id={`acc-trigger-${section.id}`}
                data-acc-trigger
                aria-expanded="false"
                aria-controls={`acc-panel-${section.id}`}
                class="flex min-h-14 w-full items-center justify-between gap-3 px-4 py-3 text-left transition duration-200 hover:bg-bg"
              >
                <span class="font-roboto text-sm font-medium text-ink">
                  {index + 1}. {section.title}
                </span>
                <svg
                  class="h-4 w-4 shrink-0 text-muted transition-transform duration-200"
                  data-acc-icon
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
            </h2>

            <div
              id={`acc-panel-${section.id}`}
              role="region"
              aria-labelledby={`acc-trigger-${section.id}`}
              data-acc-panel
              hidden
              class="border-t border-border px-4 py-4 text-sm text-muted"
            >
              {section.kind === "schedule" && (
                <div class="flex flex-col gap-3">
                  <DemoTag variant="fixed" />
                  <dl class="flex flex-col gap-2.5">
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Monto</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.monto, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Plazo</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {fixedTerms.plazoMeses} meses
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Tasa ordinaria</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.tasaOrdinariaAnual, 0)} anual ·{" "}
                        {formatPercent(fixedTerms.tasaOrdinariaMensualSimple, 0)} mensual simple
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Interés mensual</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.interesMensual, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Intereses totales</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.interesTotal, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Pagos</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {pagosTexto}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Comisión de apertura</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.comisionApertura, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Monto neto que recibe el cliente</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.montoNetoRecibido, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Total de pagos</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.totalPagos, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Total pagado (incluye comisión de apertura)</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.totalPagadoConApertura, 2)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Tasa moratoria mensual</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.tasaMoratoriaMensual, 0)} (
                        {formatPercent(fixedTerms.equivalenciaMoraAnual, 0)} anual nominal simple)
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">CAT anual</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.catAnual, 1)} (
                        {formatPercent(fixedTerms.catMensual, 2)} mensual)
                      </dd>
                    </div>
                  </dl>

                  <div>
                    <h3 class="mb-2 font-roboto text-sm font-semibold text-ink">
                      Tabla de amortización (caso base)
                    </h3>
                    <div class="overflow-x-auto rounded-xl border border-border">
                      <table class="w-full min-w-[560px] border-collapse text-left text-xs">
                        <thead class="bg-bg text-muted">
                          <tr>
                            <th class="px-3 py-2 font-medium">Mes</th>
                            <th class="px-3 py-2 font-medium">Saldo inicial</th>
                            <th class="px-3 py-2 font-medium">Capital</th>
                            <th class="px-3 py-2 font-medium">Interés</th>
                            <th class="px-3 py-2 font-medium">Pago</th>
                            <th class="px-3 py-2 font-medium">Saldo final</th>
                          </tr>
                        </thead>
                        <tbody>
                          {scheduleRows.map((row) => (
                            <tr class="border-t border-border">
                              <td class="px-3 py-2 text-ink">{row.mes}</td>
                              <td class="px-3 py-2 text-muted">{row.saldoInicial}</td>
                              <td class="px-3 py-2 text-muted">{row.capital}</td>
                              <td class="px-3 py-2 text-muted">{row.interes}</td>
                              <td class="px-3 py-2 text-ink">{row.pago}</td>
                              <td class="px-3 py-2 text-muted">{row.saldoFinal}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              )}

              {section.kind === "rates" && (
                <div class="flex flex-col gap-3">
                  <DemoTag variant="fixed" />
                  <dl class="flex flex-col gap-2.5">
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Tasa ordinaria anual fija</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.tasaOrdinariaAnual)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Tasa ordinaria mensual simple fija</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.tasaOrdinariaMensualSimple)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Tasa moratoria mensual fija</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.tasaMoratoriaMensual)}
                      </dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Equivalencia mora anual nominal simple</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatPercent(fixedTerms.equivalenciaMoraAnual)}
                      </dd>
                    </div>
                  </dl>
                  <p class="leading-relaxed">
                    La tasa ordinaria se mantiene fija mientras el contrato conserve esa condición.
                  </p>

                  <div class="rounded-xl border border-border bg-bg p-3">
                    <h3 class="font-roboto text-sm font-semibold text-ink">Interés moratorio</h3>
                    <p class="mt-1 leading-relaxed">
                      Se aplica únicamente al capital vencido y en proporción a los días efectivos de
                      atraso; no se capitaliza ni se calcula sobre el interés ordinario.
                    </p>
                    <p class="mt-2 rounded-lg bg-surface px-3 py-2 font-mono text-xs text-ink">
                      interés moratorio = capital vencido × 25.00% × días de atraso ÷ 30
                    </p>
                  </div>

                  <div>
                    <p class="mb-2 text-xs text-muted">
                      Ejemplo con capital vencido {formatMXN(fixedTerms.capitalVencidoEjemplo, 2)} y
                      pago vencido {formatMXN(fixedTerms.pagoVencidoEjemplo, 2)}.
                    </p>
                    <div class="overflow-x-auto rounded-xl border border-border">
                      <table class="w-full min-w-[360px] border-collapse text-left text-xs">
                        <thead class="bg-bg text-muted">
                          <tr>
                            <th class="px-3 py-2 font-medium">Días</th>
                            <th class="px-3 py-2 font-medium">Interés moratorio</th>
                            <th class="px-3 py-2 font-medium">Total estimado</th>
                          </tr>
                        </thead>
                        <tbody>
                          {moraRows.map((row) => (
                            <tr class="border-t border-border">
                              <td class="px-3 py-2 text-ink">{row.dias}</td>
                              <td class="px-3 py-2 text-muted">{row.mora}</td>
                              <td class="px-3 py-2 text-ink">{row.total}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              )}

              {section.kind === "cat" && (
                <div class="flex flex-col gap-3">
                  <DemoTag variant="fixed" />
                  <div>
                    <p class="font-display text-3xl font-bold text-ink">
                      {formatPercent(fixedTerms.catAnual, 1)}
                    </p>
                    <p class="mt-1 text-sm text-muted">
                      CAT mensual equivalente {formatPercent(fixedTerms.catMensual, 2)}
                    </p>
                    <p class="mt-1 text-xs text-muted">
                      Sin IVA y para fines informativos y de comparación.
                    </p>
                  </div>

                  <div class="rounded-xl border border-border bg-bg p-3">
                    <h3 class="font-roboto text-sm font-semibold text-ink">Base del cálculo</h3>
                    <dl class="mt-2 flex flex-col gap-2">
                      <div class="flex items-start justify-between gap-3">
                        <dt class="text-muted">Monto nominal</dt>
                        <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                          {formatMXN(fixedTerms.monto, 2)}
                        </dd>
                      </div>
                      <div class="flex items-start justify-between gap-3">
                        <dt class="text-muted">Comisión de apertura</dt>
                        <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                          {formatMXN(fixedTerms.comisionApertura, 2)}
                        </dd>
                      </div>
                      <div class="flex items-start justify-between gap-3">
                        <dt class="text-muted">Monto neto recibido</dt>
                        <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                          {formatMXN(fixedTerms.montoNetoRecibido, 2)}
                        </dd>
                      </div>
                      <div class="flex items-start justify-between gap-3">
                        <dt class="text-muted">Pagos</dt>
                        <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                          Seis pagos: cinco de {formatMXN(fixedTerms.pagoMensual1a5, 2)} y uno de{" "}
                          {formatMXN(fixedTerms.pagoMensual6, 2)}
                        </dd>
                      </div>
                    </dl>
                  </div>

                  <p class="rounded-xl bg-amber-50 px-3 py-2 text-xs leading-relaxed text-amber-700">
                    Este CAT permanece igual únicamente si se conservan el monto, el plazo, la
                    comisión, la tasa y el calendario de pagos. Si cualquiera cambia, el CAT debe
                    recalcularse.
                  </p>

                  <p class="text-xs leading-relaxed text-muted">{fixedTerms.fuenteMetodologica}</p>
                </div>
              )}

              {section.kind === "fees" && (
                <div class="flex flex-col gap-3">
                  <DemoTag variant="fixed" />
                  <dl class="flex flex-col gap-2.5">
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Comisión de apertura</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.comisionApertura, 2)}
                      </dd>
                    </div>
                    <p class="text-xs text-muted">
                      Se descuenta del monto; el cliente recibe{" "}
                      {formatMXN(fixedTerms.montoNetoRecibido, 2)}.
                    </p>
                    <div class="flex items-start justify-between gap-3">
                      <dt class="text-muted">Comisión adicional por pago tardío</dt>
                      <dd class="shrink-0 text-right font-roboto font-medium text-ink">
                        {formatMXN(fixedTerms.comisionPagoTardio, 2)}
                      </dd>
                    </div>
                  </dl>

                  <p class="text-xs leading-relaxed">
                    El costo del incumplimiento se cobra mediante el interés moratorio (ver “Tasas
                    de interés aplicables”); su importe no es de $0.00, depende del capital vencido y
                    los días de atraso.
                  </p>

                  <div class="flex items-start justify-between gap-3 border-t border-border pt-3">
                    <span class="text-muted">Total pagado (incluye comisión de apertura)</span>
                    <span class="shrink-0 text-right font-roboto font-semibold text-ink">
                      {formatMXN(fixedTerms.totalPagadoConApertura, 2)}
                    </span>
                  </div>
                  <p class="text-xs text-muted">
                    Pagos por {formatMXN(fixedTerms.totalPagos, 2)} más{" "}
                    {formatMXN(fixedTerms.comisionApertura, 2)} de apertura.
                  </p>

                  <div class="flex items-start justify-between gap-3">
                    <span class="text-muted">Registro de comisiones ante CONDUSEF</span>
                    <span class="shrink-0 text-right font-roboto font-medium text-ink">
                      Pendiente de definir
                    </span>
                  </div>
                </div>
              )}

              {section.kind === "privacy" && (
                <div class="flex flex-col gap-2.5">
                  <div>
                    <DemoTag label="Texto de ejemplo para el prototipo" />
                  </div>
                  <p class="leading-relaxed">{privacyExampleText}</p>
                </div>
              )}

              {section.kind === "contract" && (
                <div class="flex flex-col gap-3">
                  <DemoTag variant="fixed" label={`Estado: ${legalMeta.status}`} />
                  <p class="leading-relaxed">{contractReca.description}</p>
                  <p>
                    <span class="text-muted">Número de registro RECA:</span>{" "}
                    <span class="font-roboto font-medium text-ink">{recaNumber}</span>
                  </p>

                  {
                    hasContractPdf && (
                      <a
                        href="/legal/contrato.pdf"
                        download
                        class="inline-flex min-h-11 w-fit items-center gap-1.5 rounded-full border border-border px-4 text-sm font-semibold text-ink transition duration-200 hover:bg-slate-100"
                      >
                        Descargar PDF
                      </a>
                    )
                  }

                  <div class="legal-doc" set:html={contrato.intro} />

                  <div class="flex flex-col gap-2">
                    {contrato.sections.map((sec, i) => (
                      <details class="legal-subdetails" open={i === 0}>
                        <summary>{sec.title}</summary>
                        <div class="legal-doc legal-doc--panel" set:html={sec.body} />
                      </details>
                    ))}
                  </div>

                  <p class="text-xs leading-relaxed text-muted">{legalMeta.notice}</p>
                </div>
              )}

              {section.kind === "registry" && (
                <div class="flex flex-col gap-2.5">
                  <p class="leading-relaxed">{section.data.description}</p>
                  <p>
                    <span class="text-muted">Número de registro:</span>{" "}
                    <span class="font-roboto font-medium text-ink">{section.data.registry}</span>
                  </p>
                </div>
              )}

              {section.kind === "legal" && (
                <div class="flex flex-col gap-3">
                  <DemoTag variant="fixed" label={`Estado: ${legalMeta.status}`} />
                  <div class="legal-doc" set:html={disposiciones} />
                  <p class="text-xs leading-relaxed text-muted">{legalMeta.notice}</p>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-xs leading-relaxed text-muted">
      Antes de usarse en operaciones reales, estas condiciones deben validarse con el área jurídica y
      de cumplimiento.
    </p>
  </div>
</section>

<script>
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-acc-trigger]")
  );

  const panelFor = (trigger: HTMLButtonElement): HTMLElement | null => {
    const id = trigger.getAttribute("aria-controls");
    return id ? document.getElementById(id) : null;
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      triggers.forEach((other) => {
        other.setAttribute("aria-expanded", "false");
        const panel = panelFor(other);
        if (panel) panel.hidden = true;
      });

      if (!isOpen) {
        trigger.setAttribute("aria-expanded", "true");
        const panel = panelFor(trigger);
        if (panel) panel.hidden = false;
      }
    });
  });
</script>

<style>
  [data-acc-trigger][aria-expanded="true"] [data-acc-icon] {
    transform: rotate(180deg);
  }

  /* Documentos legales renderizados desde markdown (set:html) */
  .legal-doc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .legal-doc :global(p) {
    margin: 0 0 0.75em;
  }

  .legal-doc :global(ul) {
    list-style: disc;
    margin: 0 0 0.75em;
    padding-left: 1.25rem;
  }

  .legal-doc :global(ol) {
    list-style: decimal;
    margin: 0 0 0.75em;
    padding-left: 1.25rem;
  }

  .legal-doc :global(li) {
    margin: 0 0 0.3em;
  }

  .legal-doc :global(h1),
  .legal-doc :global(h2),
  .legal-doc :global(h3),
  .legal-doc :global(h4) {
    font-family: var(--font-roboto);
    font-weight: 700;
    color: var(--color-ink);
    font-size: 0.95rem;
    margin: 0.9em 0 0.4em;
  }

  .legal-doc :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }

  .legal-doc :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }

  .legal-doc--panel {
    padding: 0 0.75rem 0.75rem;
  }

  .legal-subdetails {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .legal-subdetails > summary {
    display: flex;
    min-height: 2.75rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-roboto);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .legal-subdetails > summary::-webkit-details-marker {
    display: none;
  }

  .legal-subdetails[open] > summary {
    border-bottom: 1px solid var(--color-border);
  }
</style>
