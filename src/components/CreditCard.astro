---
import heroNames from "../data/hero-names.json";

interface Props {
  name?: string;
  variant?: "hero" | "app";
}

const { name = "JUAN PÉREZ", variant = "app" } = Astro.props;
const isHero = variant === "hero";
const typewriterNames = [...heroNames.personas, ...heroNames.proyectos];
---

<div
  class:list={[isHero && "w-full max-w-[26rem] [perspective:1200px]"]}
  data-tilt-stage={isHero ? "true" : undefined}
>
  <div
    data-card={isHero ? "true" : undefined}
    class="relative aspect-[85.6/53.98] w-full overflow-hidden rounded-[1.25rem] border border-white/10 bg-[linear-gradient(135deg,#17191f_0%,#0b0d12_55%,#05060a_100%)] shadow-[0_36px_90px_-18px_rgba(2,6,23,0.55),0_12px_30px_-12px_rgba(2,6,23,0.35)] ring-1 ring-white/5 [transform-style:preserve-3d] [will-change:transform]"
  >
    <!-- Pincelada azul -->
    <span
      class="pointer-events-none absolute -bottom-16 -left-10 h-[70%] w-[70%] -rotate-12 rounded-full bg-[radial-gradient(closest-side,rgba(37,99,235,0.6),transparent)] blur-2xl"
      aria-hidden="true"></span>
    <span class="pointer-events-none absolute inset-0 grain opacity-40" aria-hidden="true"></span>

    <!-- Kanji sutil en la tarjeta -->
    <span
      class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 font-kanji text-[5.5rem] leading-none text-white/[0.06]"
      aria-hidden="true">縁</span
    >

    <div class="relative flex h-full flex-col justify-between p-5 sm:p-6">
      <div class="flex items-start justify-between">
        <!-- Chip EMV plateado -->
        <span
          class="inline-flex h-9 w-12 overflow-hidden rounded-md bg-[linear-gradient(135deg,#f1f5f9,#94a3b8_55%,#cbd5e1)] ring-1 ring-black/20"
          aria-hidden="true"
        >
          <svg viewBox="0 0 48 36" class="h-full w-full" fill="none">
            <path
              d="M0 12h14M0 24h14M34 12h14M34 24h14M14 0v36M34 0v36M14 12h20M14 24h20"
              stroke="#334155"
              stroke-width="1"
              opacity="0.6"></path>
          </svg>
        </span>

        <!-- Contactless -->
        <svg
          class="h-6 w-6 text-white/60"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M7 8.5a5 5 0 0 1 0 7"></path>
          <path d="M10.5 6.5a8 8 0 0 1 0 11"></path>
          <path d="M14 4.5a11 11 0 0 1 0 15"></path>
        </svg>
      </div>

      <div>
        {
          isHero && (
            <p class="mb-2 min-h-[1.2em] font-mono text-xs uppercase leading-none tracking-[0.3em] text-white/85 sm:text-sm">
              <span
                data-typewriter
                data-names={JSON.stringify(typewriterNames)}
                aria-hidden="true">{typewriterNames[0]}</span
              ><span data-typewriter-cursor class="typewriter-cursor" aria-hidden="true"></span>
            </p>
          )
        }
        <p class="font-mono text-sm tracking-[0.35em] text-white/85 sm:text-base">
          •••• •••• •••• 縁
        </p>
        <div class="mt-3 flex items-end justify-between">
          <span
            data-card-name
            class="text-xs uppercase tracking-[0.3em] text-white/65">{name.toUpperCase()}</span
          >
          <span class="text-xs text-white/65">12/29</span>
        </div>
        <span class="tri-line mt-3 block h-[3px] w-24 rounded-full" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  const mm = gsap.matchMedia();

  // Tilt 3D con el cursor — solo punteros finos con hover.
  mm.add(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
    () => {
      const stage = document.querySelector<HTMLElement>("[data-tilt-stage]");
      const card = document.querySelector<HTMLElement>("[data-card]");
      if (!stage || !card) return;

      const rx = gsap.quickTo(card, "rotationX", { duration: 0.5, ease: "power3" });
      const ry = gsap.quickTo(card, "rotationY", { duration: 0.5, ease: "power3" });

      const onMove = (e: MouseEvent) => {
        const r = stage.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        rx(-py * 14);
        ry(px * 18);
      };
      const onLeave = () => {
        rx(0);
        ry(0);
      };

      stage.addEventListener("mousemove", onMove);
      stage.addEventListener("mouseleave", onLeave);
      return () => {
        stage.removeEventListener("mousemove", onMove);
        stage.removeEventListener("mouseleave", onLeave);
        gsap.set(card, { rotationX: 0, rotationY: 0 });
      };
    }
  );

  // Flotación suave en bucle — dispositivos sin hover (móvil/táctil).
  mm.add("(hover: none) and (prefers-reduced-motion: no-preference)", () => {
    const card = document.querySelector<HTMLElement>("[data-card]");
    if (!card) return;
    const tween = gsap.to(card, {
      y: -14,
      duration: 3.2,
      ease: "sine.inOut",
      repeat: -1,
      yoyo: true,
    });
    return () => tween.kill();
  });
</script>

<style>
  .typewriter-cursor {
    display: inline-block;
    width: 0.5ch;
    height: 1em;
    margin-left: 1px;
    background: currentColor;
    vertical-align: -0.12em;
    animation: typewriter-blink 1s steps(1) infinite;
  }

  @keyframes typewriter-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor {
      display: none;
    }
  }
</style>

<script>
  const typewriter = document.querySelector<HTMLElement>("[data-typewriter]");

  if (typewriter) {
    let names: string[] = [];
    try {
      names = JSON.parse(typewriter.dataset.names ?? "[]");
    } catch {
      names = [];
    }
    if (names.length === 0) names = [typewriter.textContent ?? ""];

    const cursor = document.querySelector<HTMLElement>("[data-typewriter-cursor]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce) {
      typewriter.textContent = names[0];
      cursor?.remove();
    } else {
      let index = 0;
      let char = 0;
      let deleting = false;
      let active = false;
      let inView = false;
      let timer = 0;

      const schedule = (ms: number) => {
        if (active) timer = window.setTimeout(step, ms);
      };

      const step = () => {
        const current = names[index % names.length];
        if (!deleting) {
          char++;
          typewriter.textContent = current.slice(0, char);
          if (char >= current.length) {
            deleting = true;
            schedule(1300);
          } else {
            schedule(70);
          }
        } else {
          char--;
          typewriter.textContent = current.slice(0, char);
          if (char <= 0) {
            deleting = false;
            index = (index + 1) % names.length;
            schedule(300);
          } else {
            schedule(40);
          }
        }
      };

      const start = () => {
        if (active) return;
        active = true;
        schedule(200);
      };

      const stop = () => {
        active = false;
        window.clearTimeout(timer);
      };

      const target = typewriter.closest("[data-card]") ?? typewriter;
      const observer = new IntersectionObserver(
        (entries) => {
          inView = entries[0]?.isIntersecting ?? false;
          if (inView && !document.hidden) start();
          else stop();
        },
        { threshold: 0.2 }
      );
      observer.observe(target);

      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && inView) start();
        else stop();
      });
    }
  }
</script>
