---
// 8 puntos de seguridad. Solo 1–6 viven sobre la tarjeta (con punto numerado);
// 7–8 pertenecen a la app y se enlazan a la sección #app.
const puntos = [
  {
    n: 1,
    titulo: "Chip EMV",
    desc: "Firma cada operación y bloquea la clonación.",
    icon: ["M5 6h14v12H5z", "M5 10h14M5 14h14M10 6v12M14 6v12"],
    dot: { face: "front", x: 14, y: 41, anchor: "left" },
  },
  {
    n: 2,
    titulo: "Pago sin contacto",
    desc: "Tokens cifrados, sin exponer tu identidad.",
    icon: ["M8 9a4 4 0 0 1 0 6", "M11.5 7a7 7 0 0 1 0 10", "M15 5a10 10 0 0 1 0 14"],
    dot: { face: "front", x: 86, y: 42, anchor: "right" },
  },
  {
    n: 3,
    titulo: "Sello holográfico",
    desc: "Confirma que la tarjeta es original.",
    icon: [
      "M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 1 0 0-7",
      "M15 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 1 0 0-7",
    ],
    dot: { face: "front", x: 87, y: 84, anchor: "right" },
  },
  {
    n: 4,
    titulo: "Microtexto",
    desc: "Detalle imposible de replicar.",
    icon: ["M4 8h16", "M4 12h10", "M4 16h7"],
    dot: { face: "front", x: 50, y: 62, anchor: "center" },
  },
  {
    n: 5,
    titulo: "Datos ocultos",
    desc: "Tu número vive cifrado, nunca impreso.",
    icon: ["M3 5h18v14H3z", "M3 9h18", "M4.5 19.5 19.5 4.5"],
    dot: { face: "back", x: 8, y: 72, anchor: "left" },
  },
  {
    n: 6,
    titulo: "CVV en la app",
    desc: "Código dinámico que cambia cada vez.",
    icon: [
      "M19 12a7 7 0 0 1-12 5",
      "M7 17v-3h3",
      "M7 14h3",
      "M7 15h1M10.5 15h1M14 15h1",
    ],
    dot: { face: "back", x: 58, y: 85, anchor: "right" },
  },
  {
    n: 7,
    titulo: "Biometría",
    desc: "Acceso con huella o rostro. Solo tú autorizas.",
    icon: [
      "M7 10a5 5 0 0 1 10 0",
      "M4.5 12.5a7.5 7.5 0 0 1 15 0",
      "M12 11v6",
      "M9 13.5v3a3 3 0 0 0 6 0v-1",
    ],
  },
  {
    n: 8,
    titulo: "Bloqueo y alertas",
    desc: "Congela la tarjeta y recibe avisos al instante.",
    icon: [
      "M12 3a6 6 0 0 0-6 6c0 5-2 6-2 6h16s-2-1-2-6a6 6 0 0 0-6-6",
      "M10 21a2 2 0 0 0 4 0",
    ],
  },
];

const frontDots = puntos.filter((p) => p.dot && p.dot.face === "front");
const backDots = puntos.filter((p) => p.dot && p.dot.face === "back");
---

<section id="blindaje" data-security class="border-t border-white/10 bg-surface/40">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <!-- Encabezado -->
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.32em] text-accent">
          Blindaje EN
        </p>
        <h2 class="text-[clamp(1.875rem,4.5vw,3rem)] font-bold leading-none">
          <span class="text-ink">Blindaje</span> <span class="text-accent">EN</span>
        </h2>
        <span class="tri-line mt-4 block h-[3px] w-24 rounded-full sm:w-28" aria-hidden="true"
        ></span>
      </div>

      <!-- Marca (refuerzo de la infografía) -->
      <div class="hidden items-center gap-3 sm:flex">
        <span class="font-kanji text-2xl leading-none text-ink" aria-hidden="true">縁</span>
        <span class="flex flex-col gap-1.5">
          <span class="font-display text-xs tracking-[0.28em] text-ink">EN CREDIT</span>
          <span class="tri-line h-[3px] w-full rounded-full" aria-hidden="true"></span>
        </span>
      </div>
    </div>

    <div class="mt-12 grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Tarjeta flip -->
      <div class="flex flex-col items-center gap-6">
        <div class="w-full max-w-[30rem] [perspective:1600px]">
          <div
            data-card-inner
            class="security-card-inner relative aspect-[85.6/53.98] w-full transition-transform duration-700 [transform-style:preserve-3d] [will-change:transform]"
          >
            <!-- ===================== FRENTE ===================== -->
            <div
              data-face="front"
              class="security-face absolute inset-0 [backface-visibility:hidden]"
            >
              <div
                class="security-face-bg absolute inset-0 overflow-hidden rounded-[1.25rem] border border-white/10 bg-[linear-gradient(135deg,#17191f_0%,#0b0d12_55%,#05060a_100%)] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)] ring-1 ring-white/5"
              >
                <!-- Pincelada diagonal (arriba-derecha → abajo-izquierda) -->
                <span
                  class="pointer-events-none absolute -right-[18%] -top-[30%] h-[150%] w-[52%] -rotate-[35deg] bg-[linear-gradient(180deg,rgba(37,99,235,0.6),rgba(37,99,235,0.04))] blur-2xl"
                  aria-hidden="true"></span>
                <span
                  class="pointer-events-none absolute inset-0 grain opacity-40"
                  aria-hidden="true"></span>
                <span
                  class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 font-kanji text-4xl leading-none text-white/[0.05]"
                  aria-hidden="true">縁</span
                >
              </div>

              <div class="relative h-full w-full">
                <!-- Logo -->
                <div class="absolute left-[7%] top-[10%] flex items-center gap-1.5">
                  <span class="font-kanji text-sm leading-none text-ink sm:text-base">縁</span>
                  <span class="flex flex-col gap-1">
                    <span class="text-[0.5rem] tracking-[0.28em] text-ink sm:text-[0.55rem]"
                      >EN CREDIT</span
                    >
                    <span class="tri-line h-[2px] w-full"></span>
                  </span>
                </div>

                <!-- Etiqueta CRÉDITO -->
                <span
                  class="absolute right-[8%] top-[30%] text-[0.5rem] uppercase tracking-[0.25em] text-white/60"
                  >Crédito</span
                >

                <!-- Chip EMV -->
                <span
                  class="absolute left-[8%] top-[30%] aspect-[4/3] w-[13%] overflow-hidden rounded-md bg-[linear-gradient(135deg,#f1f5f9,#94a3b8_55%,#cbd5e1)] ring-1 ring-black/20"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 48 36" class="h-full w-full" fill="none">
                    <path
                      d="M0 12h14M0 24h14M34 12h14M34 24h14M14 0v36M34 0v36M14 12h20M14 24h20"
                      stroke="#334155"
                      stroke-width="1"
                      opacity="0.6"></path>
                  </svg>
                </span>

                <!-- Contactless -->
                <svg
                  class="absolute right-[8%] top-[40%] h-4 w-4 text-white/60"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M7 8.5a5 5 0 0 1 0 7"></path>
                  <path d="M10.5 6.5a8 8 0 0 1 0 11"></path>
                  <path d="M14 4.5a11 11 0 0 1 0 15"></path>
                </svg>

                <!-- Microtexto -->
                <span
                  class="absolute left-[50%] top-[58%] w-[30%] text-[0.4rem] tracking-[0.2em] text-white/35"
                  >EN CREDIT · 縁 · SECURE</span
                >

                <!-- Nombre -->
                <span
                  class="absolute bottom-[10%] left-[7%] text-[0.55rem] uppercase tracking-[0.15em] text-white/80 sm:text-[0.6rem]"
                  >Nombre Apellido</span
                >

                <!-- Holograma -->
                <svg
                  class="absolute bottom-[8%] right-[7%] h-5 w-9"
                  viewBox="0 0 40 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle cx="15" cy="12" r="8" stroke="#f59e0b" stroke-width="1.5" opacity="0.85"
                  ></circle>
                  <circle
                    cx="25"
                    cy="12"
                    r="8"
                    stroke="#ef4444"
                    stroke-width="1.5"
                    opacity="0.7"></circle>
                </svg>
              </div>

              <!-- Puntos frente -->
              {
                frontDots.map((p) => (
                  <button
                    type="button"
                    class="security-dot"
                    data-dot={p.n}
                    data-face={p.dot.face}
                    aria-label={`${p.n}. ${p.titulo}`}
                    aria-expanded="false"
                    aria-describedby={`tip-${p.n}`}
                    style={`--x:${p.dot.x}%;--y:${p.dot.y}%;`}
                  >
                    <span class="dot-pulse" aria-hidden="true" />
                    <span class="dot-core">{p.n}</span>
                    <span
                      id={`tip-${p.n}`}
                      role="tooltip"
                      class="dot-tooltip"
                      data-anchor={p.dot.anchor}
                    >
                      <strong>{p.titulo}</strong>
                      <span>{p.desc}</span>
                    </span>
                  </button>
                ))
              }
            </div>

            <!-- ===================== REVERSO ===================== -->
            <div
              data-face="back"
              class="security-face absolute inset-0 [backface-visibility:hidden] [transform:rotateY(180deg)]"
            >
              <div
                class="security-face-bg absolute inset-0 overflow-hidden rounded-[1.25rem] border border-white/10 bg-[linear-gradient(135deg,#12151c_0%,#08090d_100%)] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)] ring-1 ring-white/5"
              >
                <!-- Pincelada en esquinas inferiores -->
                <span
                  class="pointer-events-none absolute -bottom-[30%] -left-[20%] h-[80%] w-[60%] rounded-full bg-[radial-gradient(closest-side,rgba(37,99,235,0.45),transparent)] blur-2xl"
                  aria-hidden="true"></span>
                <span
                  class="pointer-events-none absolute -bottom-[30%] -right-[20%] h-[80%] w-[60%] rounded-full bg-[radial-gradient(closest-side,rgba(37,99,235,0.35),transparent)] blur-2xl"
                  aria-hidden="true"></span>
                <span
                  class="pointer-events-none absolute inset-0 grain opacity-40"
                  aria-hidden="true"></span>
              </div>

              <div class="relative h-full w-full">
                <!-- Banda magnética -->
                <span
                  class="absolute inset-x-0 top-[10%] h-[16%] bg-[#05060a] ring-1 ring-white/5"
                  aria-hidden="true"></span>

                <!-- Panel de firma -->
                <span
                  class="absolute left-[8%] top-[38%] h-[22%] w-[62%] overflow-hidden rounded-[3px] bg-[linear-gradient(180deg,#d7dee8,#9aa6b6)]"
                  aria-hidden="true"
                >
                  <span class="absolute inset-x-3 top-1/2 h-[1px] -translate-y-1/2 bg-slate-500/40"
                  ></span>
                  <span
                    class="absolute inset-x-3 top-[30%] h-[1px] bg-slate-500/25"></span>
                  <span
                    class="absolute inset-x-3 top-[70%] h-[1px] bg-slate-500/25"></span>
                </span>

                <!-- Etiquetas del panel -->
                <span
                  class="absolute left-[8%] top-[31%] text-[0.45rem] uppercase tracking-[0.2em] text-white/60"
                  >Firma autorizada</span
                >
                <span
                  class="absolute right-[8%] top-[31%] text-right text-[0.45rem] uppercase tracking-[0.2em] text-white/60"
                  >Uso exclusivo del titular</span
                >

                <!-- Sin número impreso -->
                <span
                  class="absolute left-[8%] top-[66%] text-[0.55rem] font-semibold uppercase tracking-[0.15em] text-white/80"
                  >Sin número impreso</span
                >

                <!-- Claim -->
                <span class="absolute right-[8%] top-[62%] text-right">
                  <span
                    class="block text-[0.5rem] font-semibold uppercase tracking-[0.15em] text-ink"
                    >Tu seguridad</span
                  >
                  <span
                    class="block text-[0.5rem] uppercase tracking-[0.15em] text-muted"
                    >Nuestro compromiso</span
                  >
                  <span class="tri-line ml-auto mt-1 block h-[2px] w-8"></span>
                </span>

                <!-- Nota CVV -->
                <span
                  class="absolute right-[8%] top-[80%] flex w-[42%] items-start gap-1 text-[0.4rem] leading-tight text-muted"
                >
                  <svg
                    class="mt-[1px] h-2.5 w-2.5 shrink-0 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 3 5 6v6c0 4 3 7 7 9 4-2 7-5 7-9V6z"></path>
                    <path d="M9.5 12l1.8 1.8L15 10"></path>
                  </svg>
                  El código de verificación (CVV) no está impreso en esta tarjeta.
                </span>
              </div>

              <!-- Puntos reverso -->
              {
                backDots.map((p) => (
                  <button
                    type="button"
                    class="security-dot"
                    data-dot={p.n}
                    data-face={p.dot.face}
                    aria-label={`${p.n}. ${p.titulo}`}
                    aria-expanded="false"
                    aria-describedby={`tip-${p.n}`}
                    style={`--x:${p.dot.x}%;--y:${p.dot.y}%;`}
                  >
                    <span class="dot-pulse" aria-hidden="true" />
                    <span class="dot-core">{p.n}</span>
                    <span
                      id={`tip-${p.n}`}
                      role="tooltip"
                      class="dot-tooltip"
                      data-anchor={p.dot.anchor}
                    >
                      <strong>{p.titulo}</strong>
                      <span>{p.desc}</span>
                    </span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Botón flip -->
        <button
          type="button"
          data-flip
          aria-pressed="false"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-6 text-sm font-semibold text-ink transition duration-300 hover:border-white/30 hover:bg-white/5"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 9a8 8 0 0 1 13.5-3.5L20 8"></path>
            <path d="M20 15a8 8 0 0 1-13.5 3.5L4 16"></path>
            <path d="M20 4v4h-4"></path>
            <path d="M4 20v-4h4"></path>
          </svg>
          <span data-flip-label>Ver reverso</span>
        </button>
      </div>

      <!-- Lista numerada 1–8 -->
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.32em] text-accent">
          Los 8 puntos
        </p>
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            puntos.map((p) => (
              <li>
                <button
                  type="button"
                  data-list-dot={p.n}
                  class="security-list-item flex h-full w-full items-start gap-3 rounded-xl border border-white/10 bg-bg/60 p-3 text-left transition duration-300 hover:border-accent/40 hover:bg-bg"
                >
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-bold text-ink">
                    {p.n}
                  </span>
                  <span class="mt-0.5 shrink-0 text-accent">
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {p.icon.map((d) => (
                        <path d={d}></path>
                      ))}
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold text-ink">{p.titulo}</span>
                    <span class="mt-0.5 block text-xs leading-snug text-muted">{p.desc}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        <!-- Franja app -->
        <div
          class="mt-6 flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-bg/60 p-4 text-center sm:flex-row sm:justify-between sm:text-left"
        >
          <p class="text-sm text-muted">
            Y desde la app:
            <span class="font-semibold text-ink">7 Biometría</span> ·
            <span class="font-semibold text-ink">8 Bloqueo y alertas</span>
          </p>
          <a
            href="#app"
            class="inline-flex min-h-11 shrink-0 items-center gap-1 rounded-full border border-white/15 px-4 text-sm font-semibold text-ink transition duration-300 hover:border-white/30 hover:bg-white/5"
          >
            Ver la app
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Pie -->
    <div class="mt-14 text-center">
      <p class="text-sm text-muted">
        La personalización complementa la seguridad de la tarjeta.
      </p>
      <span class="tri-line mx-auto mt-4 block h-[3px] w-24 rounded-full" aria-hidden="true"
      ></span>
    </div>
  </div>
</section>

<style>
  .security-card-inner {
    transform: rotateY(0deg);
  }

  .security-dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 30;
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .security-dot .dot-core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0 0 3px rgb(10 13 20 / 0.75);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .security-dot .dot-pulse {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.5rem;
    height: 1.5rem;
    margin: -0.75rem 0 0 -0.75rem;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    animation: dotPulse 2.6s ease-out infinite;
  }

  @keyframes dotPulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70% {
      opacity: 0;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .security-dot:hover .dot-core,
  .security-dot:focus-visible .dot-core,
  .security-dot.is-active .dot-core {
    background: var(--color-accent-hover);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .security-dot .dot-tooltip {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    width: max-content;
    max-width: 11rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    background: #0b0d12;
    border: 1px solid rgb(255 255 255 / 0.15);
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.9);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease;
    pointer-events: none;
  }

  .security-dot .dot-tooltip strong {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
  }

  .security-dot .dot-tooltip span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.65rem;
    line-height: 1.3;
    color: var(--color-muted);
  }

  .security-dot .dot-tooltip[data-anchor="left"] {
    left: 0;
  }
  .security-dot .dot-tooltip[data-anchor="right"] {
    right: 0;
  }
  .security-dot .dot-tooltip[data-anchor="center"] {
    left: 50%;
    transform: translateX(-50%);
  }

  .security-dot:hover .dot-tooltip,
  .security-dot:focus-visible .dot-tooltip,
  .security-dot[aria-expanded="true"] .dot-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .security-list-item.is-active {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .security-card-inner {
      transition: none !important;
    }
    .security-dot .dot-pulse {
      animation: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-security]");

  if (root) {
    const inner = root.querySelector<HTMLElement>("[data-card-inner]");
    const flipBtn = root.querySelector<HTMLButtonElement>("[data-flip]");
    const flipLabel = root.querySelector<HTMLElement>("[data-flip-label]");
    const front = root.querySelector<HTMLElement>('[data-face="front"]');
    const back = root.querySelector<HTMLElement>('[data-face="back"]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const listItems = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-list-dot]")
    );

    let flipped = false;

    const applyFaces = () => {
      if (front) {
        front.classList.toggle("pointer-events-none", flipped);
        front.setAttribute("aria-hidden", flipped ? "true" : "false");
        (front as HTMLElement & { inert: boolean }).inert = flipped;
      }
      if (back) {
        back.classList.toggle("pointer-events-none", !flipped);
        back.setAttribute("aria-hidden", flipped ? "false" : "true");
        (back as HTMLElement & { inert: boolean }).inert = !flipped;
      }
    };

    const closeDots = () => {
      dots.forEach((d) => d.setAttribute("aria-expanded", "false"));
    };

    const setFlipped = (value: boolean) => {
      flipped = value;
      if (inner) inner.style.transform = value ? "rotateY(180deg)" : "rotateY(0deg)";
      flipBtn?.setAttribute("aria-pressed", String(value));
      if (flipLabel) flipLabel.textContent = value ? "Ver frente" : "Ver reverso";
      closeDots();
      applyFaces();
    };

    flipBtn?.addEventListener("click", () => setFlipped(!flipped));

    const highlight = (n: string) => {
      listItems.forEach((i) => i.classList.toggle("is-active", i.dataset.listDot === n));
      dots.forEach((d) => d.classList.toggle("is-active", d.dataset.dot === n));
    };

    // Puntos: hover/focus en desktop (CSS), tap/click alterna en táctil.
    dots.forEach((dot) => {
      const face = dot.dataset.face;
      const reveal = () => {
        const isVisibleFace = face === (flipped ? "back" : "front");
        if (!isVisibleFace) return;
        closeDots();
        dot.setAttribute("aria-expanded", "true");
      };
      dot.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = dot.getAttribute("aria-expanded") === "true";
        if (open) dot.setAttribute("aria-expanded", "false");
        else reveal();
        highlight(dot.dataset.dot ?? "");
      });
      dot.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          dot.setAttribute("aria-expanded", "false");
        }
      });
    });

    // Lista sincronizada: resalta, abre su tooltip y voltea si está en la otra cara.
    listItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.stopPropagation();
        const n = item.dataset.listDot ?? "";
        const dot = dots.find((d) => d.dataset.dot === n);
        const face = dot?.dataset.face;
        if (face === "back" && !flipped) setFlipped(true);
        else if (face === "front" && flipped) setFlipped(false);
        highlight(n);
        if (dot) {
          closeDots();
          dot.setAttribute("aria-expanded", "true");
        }
      });
    });

    // Tap/click fuera cierra los tooltips.
    document.addEventListener("click", (e) => {
      if ((e.target as Element)?.closest(".security-dot")) return;
      closeDots();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeDots();
    });

    applyFaces();
  }
</script>
