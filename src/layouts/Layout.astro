---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/syne/700.css";
import "@fontsource/syne/800.css";
import "@fontsource/noto-serif-jp/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "EN CREDIT (縁 CREDIT) — Créditos para proyectos artísticos y creativos",
  description = "La primera tarjeta creada para respaldar proyectos artísticos, creativos y personales sin barreras burocráticas. El arte también mueve al mundo.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0D14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen w-full overflow-x-hidden bg-bg">
    <slot />
  </body>
</html>
